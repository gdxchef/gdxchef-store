let adTimer,adIdx=0;
async function loadAds(){
  const{data}=await db.from('ads').select('image_url').eq('is_active',true);
  const box=$('ads');const list=(data||[]).filter(a=>safeUrl(a.image_url));
  if(!list.length){box.style.display='none';return}
  box.style.display='block';
  box.innerHTML=list.map((a,i)=>`<div class="slide${i?'':' on'}"><img src="${esc(a.image_url)}" alt="إعلان"${i?' loading="lazy"':''}></div>`).join('')
    +(list.length>1?`<div class="dots">${list.map((_,i)=>`<button class="${i?'':'on'}" data-ad="${i}"></button>`).join('')}</div>`:'');
  adIdx=0;clearInterval(adTimer);
  if(list.length>1)adTimer=setInterval(()=>goAd(adIdx+1),3000);
}
function goAd(n){
  const s=document.querySelectorAll('#ads .slide');if(!s.length)return;
  adIdx=(n+s.length)%s.length;
  s.forEach((e,i)=>e.classList.toggle('on',i===adIdx));
  document.querySelectorAll('#ads .dots button').forEach((e,i)=>e.classList.toggle('on',i===adIdx));
}

// Events
document.addEventListener('click',e=>{
  if(e.target.classList.contains('modal'))return closeAll();
  const el=e.target.closest('[data-act],[data-page],[data-close],[data-copy],[data-ad]');
  if(!el)return;
  const d=el.dataset;
  if(d.ad!==undefined){goAd(+d.ad);clearInterval(adTimer);adTimer=setInterval(()=>goAd(adIdx+1),3000);return}
  if(d.page)return showPage(d.page);
  if('close' in d)return closeAll();
  if(d.copy)return copyText(d.copy);
  
  const p=S.products.get(d.id);
  switch(d.act){
    case'details':if(p)showDetails(p);break;
    case'buy':if(p){pdQty=1;showDetails(p);}break;
    case'pay':selectPayment(d.m);break;
    case'cat':openCat(d.id);break;
    case'retry':e.preventDefault();loadData();break;
    case'login':openModal('authModal');break;
    case'pdQty':updatePdQty(+d.d);break;
    case'payQty':S.qty=Math.min(10,Math.max(1,S.qty+(+d.d)));renderPaySum();break;
    case'zoomImg': {
       const src = d.src;
       if(src) window.open(src, '_blank');
       break;
    }
  }
});
$('pdBuyBtn').onclick=()=>{if(S.cur)buy(S.cur)};
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAll()});
$('userBtn').onclick=()=>{if(S.user)showPage('profile');else openModal('authModal')};
$('authBtn').onclick=auth;
$('authSwitch').onclick=e=>{e.preventDefault();setAuthMode(!S.signUp)};
['email','pass'].forEach(i=>$(i).addEventListener('keydown',e=>{if(e.key==='Enter')auth()}));
$('submitOrder').onclick=submitOrder;
$('pfSave').onclick=saveProfilePage;
$('nameSave').onclick=saveNameModal;
$('nameInput').addEventListener('keydown',e=>{if(e.key==='Enter')saveNameModal()});
$('waInput').addEventListener('keydown',e=>{if(e.key==='Enter')saveNameModal()});
$('nameLogout').onclick=async()=>{await db.auth.signOut();closeAll();showPage('home');toast('تم تسجيل الخروج')};
$('logoutBtn').onclick=async()=>{await db.auth.signOut();closeAll();showPage('home');toast('تم تسجيل الخروج')};
$('q-cat').addEventListener('input',renderCat);

// ticker & init
setInterval(()=>{
  const items = document.querySelectorAll('.feat-item');
  if(!items.length) return;
  let activeIndex = Array.from(items).findIndex(item => item.classList.contains('active'));
  items[activeIndex].classList.remove('active');
  activeIndex = (activeIndex + 1) % items.length;
  items[activeIndex].classList.add('active');
}, 5000);

$('year').textContent=new Date().getFullYear();
db.auth.onAuthStateChange((_e,session)=>{setTimeout(()=>onUser(session?session.user:null),0)});
loadData();loadAds();
</script>
