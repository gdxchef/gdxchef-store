// ====== المنتجات ======
function priceHtml(p){
  let h=onSale(p)?`<div class="pnow"><b>${money(p.discount_price)}</b><small>DA</small></div><div class="pold"><s>${money(p.price)} DA</s></div>`:`<div class="pnow"><b>${money(p.price)}</b><small>DA</small></div>`;
