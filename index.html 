function renderCat(){
  const c=S.cats.get(S.catId),q=$('q-cat').value.trim().toLowerCase();
  const list=[...S.products.values()].filter(p=>String(p.category_id)===S.catId && (!q||(p.name+' '+(p.description||'')).toLowerCase().includes(q)));
  
  if(!list.length){
    $('products-container').innerHTML='<div class="empty">لا توجد منتجات في هذا القسم حالياً.</div>';
    return;
  }

  const memberships = list.filter(p => p.name.toLowerCase().includes('membership') || p.name.includes('عضوية') || p.name.includes('عضويات'));
  const normalProducts = list.filter(p => !(p.name.toLowerCase().includes('membership') || p.name.includes('عضوية') || p.name.includes('عضويات')));

  let html = `<div class="grid-4 ${c&&c.kind==='account'?'acc':''}">`;
  
  if(memberships.length > 0) {
    html += memberships.map(cardHtml).join('');
  }
  
  if(memberships.length > 0 && normalProducts.length > 0) {
    html += `</div><div class="section-divider"><span>العروض العادية | Normal Top Ups</span></div><div class="grid-4 ${c&&c.kind==='account'?'acc':''}">`;
  }

  if(normalProducts.length > 0) {
    html += normalProducts.map(cardHtml).join('');
  }

  html += `</div>`;
  $('products-container').innerHTML=html;
}

function renderAccountsCats(){
  const all=[...S.products.values()];
  let list=[...S.cats.values()].filter(c=>c.kind==='account' && !c.parent_id);
  list.sort((a,b)=>(a.sort||0)-(b.sort||0));
  $('grid-accounts').innerHTML=list.length?list.map(c=>{
