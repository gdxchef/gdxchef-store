}

async function submitOrder(){
  if(S.busy)return;
  if(!S.cur)return toast('اختر منتجاً أولاً','bad');
  if(needName()){openModal('nameModal');return}
  const amountRaw=$('amount').value.trim().replace(',','.');
  const gameId=$('gameId').value.trim();
  const wa=$('wa').value.replace(/[\s+\-]/g,'');
  const file=$('file').files[0];
  const topUp=kindOf(S.cur)!=='account';

  if(topUp&&!/^[A-Za-z0-9_\-]{4,30}$/.test(gameId))return toast('أدخل آيدي اللعبة بشكل صحيح','bad');
  if(!/^\d{8,15}$/.test(wa))return toast('رقم الواتساب غير صحيح','bad');
  if(!/^\d+(\.\d{1,2})?$/.test(amountRaw)||Number(amountRaw)<=0)return toast('أدخل مبلغاً صحيحاً','bad');
  if(!file)return toast('ارفع صورة الوصل','bad');
  if(!file.type.startsWith('image/'))return toast('الملف يجب أن يكون صورة','bad');
  if(file.size>5*1024*1024)return toast('حجم الصورة أكبر من 5 ميغابايت','bad');

  const btn=$('submitOrder');S.busy=true;btn.disabled=true;btn.textContent='جاري الإرسال...';
  try{
    const ext=(file.type.split('/')[1]||'jpg').replace(/[^a-z0-9]/gi,'');
    const name=`${Date.now()}_${S.user.id.slice(0,8)}.${ext}`;
    const up=await db.storage.from('receipts').upload(name,file,{contentType:file.type});
    if(up.error)throw up.error;
    const url=db.storage.from('receipts').getPublicUrl(name).data.publicUrl;
    const ins=await db.from('orders').insert({
      user_email:S.user.email, user_id:S.user.id,
      product_name:S.cur.name, payment_method:S.method, amount_paid:amountRaw,
      receipt_url:url, game_id:topUp?gameId:null, whatsapp:wa, quantity:S.qty,
      customer_name:(S.profile&&S.profile.full_name)||null, product_id:S.cur.id,
      kind:topUp?'topup':'account', currency:S.method==='Binance'?'USD':'DZD'
    });
    if(ins.error)throw ins.error;
    toast('تم إرسال الطلب، سنراجعه قريباً','ok');closeAll();
    ['amount','gameId','wa','file'].forEach(i=>$(i).value='');
    showPage('myOrders');
  }catch(e){toast('تعذر إرسال الطلب: '+(e.message||'خطأ غير معروف'),'bad')}
  finally{S.busy=false;btn.disabled=false;btn.textContent='تأكيد الطلب'}
}

// ====== Profile & Orders ======
const orderCur=o=>o.currency||(o.payment_method==='Binance'?'USD':'DZD');
const isTop=o=>o.kind?o.kind==='topup':!!o.game_id;

async function fetchOrders(){
  if(!S.user){S.orders=[];return false}
  const{data,error}=await db.from('orders').select('*').eq('user_id',S.user.id).order('created_at',{ascending:false});
  if(error)return false;
  S.orders=data;return true;
}

async function loadOrdersPage(){
  const box=$('orders-list');
  if(!S.user){
    box.innerHTML='';
    $('login-prompt').style.display='block';
    return;
  }
  $('login-prompt').style.display='none';
  box.innerHTML='<div class="skeleton" style="height:110px"></div>';
  
  if(!await fetchOrders()){box.innerHTML='<div class="empty">تعذر تحميل الطلبات.</div>';return}
  
  const latest = S.orders.slice(0, 10);
  
  if(!latest.length){box.innerHTML='<div class="empty">لا توجد طلبات سابقة.</div>';return}
  const T={pending:'قيد الانتظار',approved:'مقبول',rejected:'مرفوض'};
  box.innerHTML=latest.map(o=>{
    const st=T[o.status]?o.status:'pending';
    const dateStr = o.created_at ? new Date(o.created_at).toLocaleString('ar-DZ', {year:'numeric',month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '';
    return `<div class="order" style="background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:12px">
    <span class="badge ${st}">${T[st]}</span>
    <h3 style="color:var(--gold);font-size:1rem">${esc(o.product_name)}${o.quantity>1?` <small style="color:var(--muted)">× ${o.quantity}</small>`:''}</h3>
    <p style="color:var(--muted);font-size:.85rem;margin-top:4px">${esc(o.payment_method)} | ${esc(o.amount_paid)} ${orderCur(o)==='USD'?'$':'DA'} | ${dateStr}</p>
    ${o.game_id?`<p style="color:var(--gold-soft);font-weight:700;font-size:.85rem;margin-top:4px">الآيدي: ${esc(o.game_id)}</p>`:''}
    ${o.rejection_reason?`<p style="color:var(--red);margin-top:4px;font-size:.85rem">سبب الرفض: ${esc(o.rejection_reason)}</p>`:''}</div>`
  }).join('');
}

async function loadProfilePage(){
  if(!S.user){
    $('profile-view').style.display='none';
    return;
  }
  $('profile-view').style.display='block';
  
  await Promise.all([loadProfile(),fetchOrders()]);
  
  $('pfEmail').textContent = S.user.email;
  $('stEmail').textContent = S.user.email;
  
  if(!document.activeElement||document.activeElement.id!=='pfInputName') $('pfInputName').value = (S.profile&&S.profile.full_name)||'';
  if(!document.activeElement||document.activeElement.id!=='pfInputWa') $('pfInputWa').value = (S.profile&&S.profile.whatsapp)||'';
  
  const ok=S.orders.filter(o=>o.status==='approved');
  
  // Star calculation (topup = 0.1, account = 0.5)
  let stars=0;
  ok.forEach(o=>{
    stars += isTop(o) ? 0.1 : 0.5;
  });
  stars = Math.min(100, Math.round(stars * 10) / 10);

  const name = (S.profile&&S.profile.full_name)||'مرحباً بك';
  $('pfName').textContent=name;
  updateAvatar(name);
  
  $('stOrders').textContent=S.orders.length;
  $('stSpent').textContent=money(ok.filter(o=>isTop(o)&&orderCur(o)==='DZD').reduce((t,o)=>t+num(o.amount_paid),0));
  $('stStars').textContent = stars + ' / 100';
  
  const wa = (S.profile && S.profile.whatsapp) ? S.profile.whatsapp : 'غير مسجل';
  $('pfWa').textContent = wa;
}

async function loadProfile(){
  if(!S.user){S.profile=null;S.profileOk=false;return}
  const{data,error}=await db.from('profiles').select('*').eq('user_id',S.user.id).maybeSingle();
  S.profileOk=!error;S.profile=data;
}
const needName=()=>!!S.user&&S.profileOk&&!(S.profile&&S.profile.full_name);

async function saveProfilePage(){
  const name=$('pfInputName').value.trim().slice(0,60);
  const wa=$('pfInputWa').value.replace(/[\s+\-]/g,'');
  if(name.length<2)return toast('اكتب اسماً صحيحاً','bad');
  if(wa && !/^\d{8,15}$/.test(wa)) return toast('رقم واتساب غير صحيح','bad');
  
  if(S.profile && S.profile.updated_at) {
    const lastUpdate = new Date(S.profile.updated_at);
    const diffDays = (new Date() - lastUpdate) / (1000 * 60 * 60 * 24);
    if(diffDays < 7) {
      return toast('لا يمكنك التعديل قبل مرور أسبوع من آخر تعديل.','bad');
    }
  }

  const btn=$('pfSave');btn.disabled=true;
  const{error}=await db.from('profiles').upsert({
    user_id:S.user.id,
    email:S.user.email,
    full_name:name,
    whatsapp:wa,
    updated_at: new Date().toISOString()
  });
  btn.disabled=false;
  if(error)return toast('تعذر حفظ البيانات','bad');
  S.profile={...(S.profile||{}),full_name:name,whatsapp:wa, updated_at:new Date().toISOString()};
  toast('تم حفظ البيانات','ok');
  loadProfilePage();
}

const fmtDate=t=>{if(!t)return '';const d=new Date(t);if(isNaN(d))return '';return 'نُشر: '+d.toLocaleDateString('ar-DZ');};

function renderPaySum(){
  if(!S.cur)return;
  const p=S.cur,acc=kindOf(p)==='account';
  $('paySum').innerHTML=`<img src="${esc(safeUrl(p.image_url)||FALLBACK)}" alt=""><div><b>${esc(p.name)}</b><small>${acc?'حساب جاهز':'شحن'}${S.qty>1?' × '+S.qty:''}</small><div class="tot">${money(finalDa(p)*S.qty)} DA${acc&&Number(p.price_usd)>0?` <span>/ $${money(finalUsd(p))}</span>`:''}</div></div>`;
  $('payQtyVal').textContent=S.qty;
}

// ====== Auth ======
async function saveNameModal(){
  const name=$('nameInput').value.trim().slice(0,60);
  const wa=$('waInput').value.replace(/[\s+\-]/g,'');
  if(name.length<2)return toast('اكتب اسماً صحيحاً','bad');
  if(!/^\d{8,15}$/.test(wa))return toast('رقم واتساب غير صحيح','bad');
  
  const btn=$('nameSave');btn.disabled=true;
  const{error}=await db.from('profiles').upsert({
    user_id:S.user.id,
    email:S.user.email,
    full_name:name,
    whatsapp:wa,
    updated_at: new Date().toISOString()
  });
  btn.disabled=false;
  if(error)return toast('تعذر حفظ البيانات','bad');
  S.profile={...(S.profile||{}),full_name:name,whatsapp:wa,updated_at:new Date().toISOString()};
  closeModal('nameModal');toast('أهلاً بك '+name,'ok');
  updateAvatar(name);
  if($('page-profile').classList.contains('active'))loadProfilePage();
}
function setAuthMode(on){
  S.signUp=on;
  $('authTitle').textContent=on?'إنشاء حساب':'تسجيل الدخول';
  $('authBtn').textContent=on?'إنشاء':'دخول';
  $('authText').textContent=on?'لديك حساب؟':'ليس لديك حساب؟';
  $('authSwitch').textContent=on?'سجّل الدخول':'أنشئ حساباً';
  $('passNote').style.display=on?'block':'none';
  $('authErr').style.display='none';
}
async function auth(){
  const email=$('email').value.trim(),password=$('pass').value,err=$('authErr'),btn=$('authBtn');
  const fail=m=>{err.textContent=m;err.style.display='block'};
  if(!email||!password)return fail('أدخل البريد وكلمة المرور');
  if(!/^\S+@\S+\.\S+$/.test(email))return fail('البريد الإلكتروني غير صالح');
  if(S.signUp&&password.length<6)return fail('كلمة المرور 6 أحرف على الأقل');
  btn.disabled=true;btn.textContent='...';err.style.display='none';
  try{
    if(S.signUp){
      const{data,error}=await db.auth.signUp({email,password});if(error)throw error;
      if(data.session){closeModal('authModal');toast('تم إنشاء الحساب','ok')}
      else{toast('تحقق من بريدك الإلكتروني ثم سجّل الدخول','ok');setAuthMode(false)}
    }else{
      const{error}=await db.auth.signInWithPassword({email,password});if(error)throw error;
      closeModal('authModal');toast('تم تسجيل الدخول','ok');
    }
  }catch(e){fail(e.message)}
  finally{btn.disabled=false;btn.textContent=S.signUp?'إنشاء':'دخول'}
}
async function onUser(user){
  S.user=user;
  $('userBtn').classList.toggle('on',!!user);
  if(!user){S.orders=[];S.profile=null;S.profileOk=false;S.settings=null; updateAvatar('U')}
  await Promise.all([loadSettings(),loadProfile()]);
  if(S.profile && S.profile.full_name) updateAvatar(S.profile.full_name);
  if(needName())openModal('nameModal');
  if($('page-myOrders').classList.contains('active'))loadOrdersPage();
  if($('page-profile').classList.contains('active'))loadProfilePage();
}

// ====== Load Data ======
async function loadSettings(){
  if(!S.user){S.settings=null;return}
  const{data,error}=await db.from('settings').select('*').eq('id',1).single();
  S.settings=error?null:data;
}
async function loadData(){
  const sk='<div class="skeleton"></div><div class="skeleton"></div>';
  ['grid-home','grid-topup-main','grid-accounts'].forEach(id=>$(id).innerHTML=sk);
  try{
    const[c,p]=await Promise.all([
      db.from('categories').select('*').eq('is_active',true).order('sort'),
      db.from('products').select('*').eq('is_hidden',false).order('created_at',{ascending:false})]);
    if(c.error||p.error)throw c.error||p.error;
    S.cats=new Map(c.data.map(x=>[String(x.id),x]));
    S.products=new Map(p.data.map(x=>[String(x.id),x]));
    renderAll();
    loadSiteInfo();
  }catch(err){
    ['grid-home','grid-topup-main','grid-accounts'].forEach(id=>$(id).innerHTML='<div class="empty">تعذر تحميل البيانات. <a href="#" data-act="retry">إعادة المحاولة</a></div>');
  }
}

