<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="GDX CHEF STORE: متجر جزائري فاخر لشحن الألعاب وبيع الحسابات.">
<meta name="theme-color" content="#0a0a0a">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%91%91%3C/text%3E%3C/svg%3E">
<title>GDX CHEF STORE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{--gold:#D4AF37;--gold-hover:#F3E5AB;--gold-soft:#E8D48A;--bg:#0a0a0a;--card:#141414;--line:#2a2a2a;--text:#F5F5F5;--muted:#A0A0A0;--yellow:#f39c12;--green:#25D366;--red:#ff4d4d;--gg:linear-gradient(135deg,#B8901F,#F3E5AB 50%,#C9A227)}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Cairo',sans-serif}
html{scroll-behavior:smooth}
body{background:radial-gradient(1200px 500px at 50% -100px,rgba(212,175,55,.09),transparent),var(--bg);color:var(--text);line-height:1.6;font-size:15px;min-height:100vh;display:flex;flex-direction:column}
button{font-family:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}

/* Header & Profile */
header{background:rgba(10,10,10,.96);backdrop-filter:blur(12px);border-bottom:1px solid rgba(212,175,55,.28);padding:8px 14px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;position:sticky;top:0;z-index:100}
.logo{display:flex;align-items:center;gap:9px;cursor:pointer;background:none;border:0;color:inherit;}
.logo svg{width:30px;height:30px;fill:url(#g);filter:drop-shadow(0 0 6px rgba(212,175,55,.5))}
.lt{display:flex;flex-direction:column;line-height:1;text-align:right}
.lt b{font-size:1.45rem;font-weight:900;letter-spacing:3px;background:var(--gg);-webkit-background-clip:text;background-clip:text;color:transparent}
.lt small{font-size:.62rem;letter-spacing:5px;color:var(--gold-soft);margin-top:3px;font-weight:700}

nav{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;order:3;width:100%;border-top:1px solid #1d1d1d;padding-top:8px; justify-content: center;}
nav::-webkit-scrollbar{display:none}
nav button{background:none;border:0;border-bottom:2px solid transparent;color:var(--text);font-size:.95rem;font-weight:700;cursor:pointer;padding:6px 12px;white-space:nowrap;transition:.2s; display:flex; flex-direction:column; align-items:center; gap:2px;}
nav button span{font-size:.75rem; color:var(--muted); font-weight:400; font-family: sans-serif; letter-spacing: 0.5px;}
nav button:hover span, nav button.active span{color:var(--gold-soft);}
nav button:hover,nav button.active{color:var(--gold);border-color:var(--gold)}
@media(min-width:760px){nav{order:0;width:auto;border:0;padding:0;margin-right:0;flex:1; justify-content: flex-end;}}

.user-btn{width:42px;height:42px;flex:none;border-radius:50%;background:#111;border:2px solid var(--gold);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.2s;color:var(--gold);font-weight:900;font-size:1.2rem;text-transform:uppercase; box-shadow: 0 0 10px rgba(212,175,55,.2);}
.user-btn:hover{background:#1a1a1a; transform:scale(1.05);}
.user-btn.on{border-color:var(--green); color:var(--green); box-shadow: 0 0 10px rgba(37,211,102,.2);}

main{flex:1;width:100%;max-width:1000px;margin:0 auto;padding:18px 14px}
.page{display:none}.page.active{display:block;animation:fd .4s}
@keyframes fd{from{opacity:0;transform:translateY(8px)}}
.hero{position:relative;overflow:hidden;background:linear-gradient(rgba(0,0,0,.8),rgba(0,0,0,.88)),url('https://images.unsplash.com/photo-1511512578047-dfb367046420?w=1200&q=70') center/cover;border:1px solid var(--gold);border-radius:18px;padding:40px 18px;text-align:center;margin-bottom:18px;box-shadow:0 0 40px rgba(212,175,55,.12)}
.hero .kick{color:var(--gold-soft);letter-spacing:6px;font-size:.75rem;font-weight:700;margin-bottom:8px}
.hero h1{font-size:2.3rem;font-weight:900;letter-spacing:3px;background:var(--gg);-webkit-background-clip:text;background-clip:text;color:transparent;line-height:1.2}
.hero p{color:#ddd;margin:10px 0 22px;font-size:1.05rem}
.hero .row2{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:20px}
.trust-new{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:15px}
.trust-new .badge{background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.3);border-radius:12px;padding:8px 12px;display:flex;align-items:center;gap:8px;font-size:.8rem;color:#ddd}
.trust-new .badge svg{width:20px;height:20px;object-fit:contain}
.btn{background:var(--gg);color:#111;border:0;cursor:pointer;padding:12px;border-radius:10px;font-weight:800;width:100%;font-size:.95rem;transition:.2s;box-shadow:0 4px 14px rgba(212,175,55,.25); display:flex; justify-content: center; align-items: center; gap: 8px;}
.btn:hover{filter:brightness(1.07)}.btn:active{transform:scale(.97)}
.btn:disabled{opacity:.55;cursor:not-allowed}
.btn.hb{width:auto;padding:12px 30px;border-radius:30px}
.btn.ghost{background:none;border:1px solid var(--gold);color:var(--gold);box-shadow:none}
.btn.green{background:linear-gradient(45deg,#25D366,#1ebe5a);color:#fff}
.btn.gray{background:#333;color:#fff;box-shadow:none}
.btn.out{background:none;border:1px solid var(--red);color:var(--red);box-shadow:none}
.btn.wa{background:#25D366;color:#fff;box-shadow:0 4px 14px rgba(37,211,102,.3); font-size:1.1rem;}
.slider{position:relative;aspect-ratio:16/6;min-height:110px;border-radius:14px;overflow:hidden;border:1px solid var(--gold);margin-bottom:18px;background:#000}
.slide{position:absolute;inset:0;opacity:0;transition:opacity .7s}.slide.on{opacity:1}
.slide img{width:100%;height:100%;object-fit:cover}
.dots{position:absolute;bottom:8px;left:0;right:0;display:flex;justify-content:center;gap:6px}
.dots button{width:8px;height:8px;border-radius:8px;border:0;background:rgba(255,255,255,.45);padding:0;cursor:pointer;transition:.3s}
.dots button.on{background:var(--gold);width:22px}
.duo{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:26px}
.big{position:relative;overflow:hidden;background:linear-gradient(160deg,#1a1a1a,#0f0f0f);border:1px solid rgba(212,175,55,.4);border-radius:16px;padding:0;color:var(--text);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:.25s;background-size:cover;background-position:center;height:140px;}
.big-overlay{position:absolute;inset:0;background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.85));z-index:1;transition:.25s;}
.big:hover{border-color:var(--gold);transform:translateY(-3px);box-shadow:0 10px 26px rgba(212,175,55,.15)}
.big:hover .big-overlay{background:linear-gradient(rgba(0,0,0,.3),rgba(0,0,0,.7));}
.big-content{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;padding:10px;}
.big-content b{font-size:1.4rem;color:var(--gold-hover);text-shadow:0 2px 4px rgba(0,0,0,.8);}
.big-content span{font-size:.85rem;color:var(--gold-soft);text-shadow:0 1px 3px rgba(0,0,0,.8); font-weight: bold; letter-spacing: 1px;}
.big-content small{color:#ddd;font-size:.8rem;text-shadow:0 1px 3px rgba(0,0,0,.8);margin-top:2px;}

.title{margin:6px 0 20px;font-size:1.35rem;font-weight:900;text-align:center;display:flex;flex-direction:column;gap:2px; color: var(--text);}
.title .en{font-size:.85rem;color:var(--gold);font-weight:700;letter-spacing:1px; text-transform: uppercase;}
.title::after{content:'';display:block;width:56px;height:3px;background:var(--gg);margin:6px auto 0;border-radius:2px}

.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:768px){.grid{grid-template-columns:repeat(3,1fr);gap:16px}}

.grid-tc{display:grid;grid-template-columns:repeat(2,1fr);gap:16px; margin-bottom: 20px;}
.grid-games{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:600px){.grid-games{grid-template-columns:repeat(3,1fr)}}
.grid-4{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:768px){.grid-4{grid-template-columns:repeat(4,1fr);gap:16px}}

.card{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;position:relative;transition:.25s}
.card:hover{border-color:var(--gold);transform:translateY(-3px)}
.card img{width:100%;aspect-ratio:1/1;object-fit:cover;cursor:pointer;background:#000}
.card.acc img{aspect-ratio:2772/1240; object-fit: cover;}
.sold{position:absolute;top:8px;right:8px;background:var(--red);color:#fff;padding:2px 10px;border-radius:20px;font-weight:700;font-size:.78rem;z-index:1}
.off{position:absolute;top:8px;left:8px;z-index:1;background:var(--red);color:#fff;padding:2px 10px;border-radius:20px;font-weight:900;font-size:.8rem;direction:ltr}
.info{padding:10px;text-align:center;display:flex;flex-direction:column;flex:1}
.info h3{color:var(--gold);font-size:.9rem;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.info p{color:var(--muted);font-size:.75rem;margin-bottom:8px;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.4}
.price{margin-bottom:10px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:2px;direction:ltr}
.pnow{display:flex;align-items:baseline;gap:5px}
.pnow b{font-size:1.3rem;font-weight:900;line-height:1.1;color:var(--gold-hover)}
.pnow small{font-size:.75rem;font-weight:700;color:var(--gold)}
.price.sale .pnow b,.price.sale .pnow small{color:var(--green)}
.pold{font-size:.75rem;color:var(--muted)}.pold s{text-decoration-color:var(--red);text-decoration-thickness:2px}
.usd{font-size:.8rem;font-weight:700;color:#7fd6a2}.usd s{color:var(--muted);font-weight:400;font-size:.75rem}

/* Top Up Categories Big Cards */
.t-cat{position:relative;border-radius:16px;overflow:hidden;aspect-ratio:16/10;cursor:pointer;border:1px solid var(--line); transition: .3s; display: flex; align-items: center; justify-content: center;}
.t-cat:hover{border-color:var(--gold); transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,.5);}
.t-cat-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover; opacity: 0.4; transition: .3s;}
.t-cat:hover .t-cat-bg{opacity: 0.6; transform: scale(1.05);}
.t-cat-overlay{position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.95), rgba(0,0,0,0.2)); z-index: 1;}
.t-cat-content{position:relative;z-index:2;text-align:center;display:flex;flex-direction:column;align-items:center;gap:4px;}
.t-cat-content b{font-size:1.4rem; color:var(--gold-hover); text-shadow: 0 2px 6px rgba(0,0,0,0.9);}
.t-cat-content span{font-size:.85rem; color:#eee; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;}
.t-cat-count{position:absolute;bottom:8px;left:8px;right:8px;background:rgba(0,0,0,0.6); border-radius:20px; padding:3px; font-size:.75rem; color:var(--gold); text-align:center; z-index:2; backdrop-filter:blur(4px);}

/* Games Grid */
.tile{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;color:var(--text);cursor:pointer;display:flex;flex-direction:column;align-items:center;padding:0 0 12px;transition:.25s}
.tile:hover{border-color:var(--gold);transform:translateY(-3px)}
.tile img{width:100%;aspect-ratio:16/10;object-fit:cover;background:#000;margin-bottom:10px}
.tile .ti{width:100%;aspect-ratio:16/10;display:grid;place-items:center;font-size:2.4rem;background:radial-gradient(circle,#241f0e,#0d0d0d);margin-bottom:10px}
.tile b{color:var(--gold);font-size:1.1rem}.tile small{color:var(--muted);font-size:.8rem}

.section-divider{display:flex;align-items:center;gap:10px;margin:30px 0 20px;color:var(--gold);font-weight:900;font-size:1.1rem}
.section-divider::before,.section-divider::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.section-divider span{white-space:nowrap}

.feats{display:grid;grid-template-columns:1fr;gap:10px;margin:20px 0 6px;position:relative;height:60px;overflow:hidden;background:var(--card);border:1px solid var(--line);border-radius:12px}
.feat-item{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:8px;opacity:0;transition:opacity .5s ease-in-out;font-weight:700;color:var(--gold-soft)}
.feat-item.active{opacity:1}
.feat-item span{font-size:1.5rem}

/* Sell Page */
.sell-box{background:var(--card);border:1px solid var(--gold);border-radius:16px;padding:24px;text-align:center;margin-bottom:20px}
.sell-box img{max-width:100%; border-radius:10px; margin:10px 0; border:1px solid var(--line);}
.sell-box p{color:var(--muted);font-size:.95rem;margin-bottom:15px;line-height:1.8}
.sell-box strong{color:var(--gold);}

/* Profile Page */
.profile-card{background:var(--card);border:1px solid var(--gold);border-radius:16px;padding:24px;margin-bottom:20px;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.5)}
.p-avatar{width:80px;height:80px;border-radius:50%;border:3px solid var(--gold);display:grid;place-items:center;font-size:2.5rem;margin:0 auto 12px;background:#111;box-shadow:0 0 20px rgba(212,175,55,.3); font-weight: 900; color: var(--gold); text-transform: uppercase;}
.p-name{color:var(--gold-hover);font-size:1.4rem;font-weight:900;margin-bottom:4px}
.p-email{color:var(--muted);font-size:.85rem;margin-bottom:12px;word-break:break-all}

.profile-grid{display:grid;grid-template-columns:repeat(2, 1fr);gap:12px;margin:20px 0}
.pf-box{background:#0d0d0d;border:1px solid var(--line);border-radius:12px;padding:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;}
.pf-box.full{grid-column:1/-1;}
.pf-box svg{width:24px;height:24px;fill:var(--gold); margin-bottom:4px;}
.pf-box b{color:var(--gold);font-size:1.3rem;direction:ltr}
.pf-box span{font-size:.8rem;color:var(--muted)}
.pf-box.green{border-color:rgba(37,211,102,.3); background:rgba(37,211,102,.05);}
.pf-box.green svg{fill:var(--green)}
.pf-box.green b{color:var(--green); font-size:1.1rem;}

/* Modals */
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.93);z-index:1000;place-items:center;padding:10px}
.modal.open{display:grid}
.box{background:var(--card);border:1px solid var(--gold);border-radius:16px;padding:24px 18px;width:100%;max-width:560px;text-align:center;position:relative;max-height:92vh;overflow-y:auto;animation:up .25s ease}
@keyframes up{from{transform:translateY(30px);opacity:0}}
.x{position:absolute;top:10px;left:14px;background:none;border:0;color:var(--muted);font-size:1.8rem;cursor:pointer;line-height:1}
.x:hover{color:var(--gold)}
.box h2{color:var(--gold);margin-bottom:14px}

/* Product Details Modal */
.pd-modal .box{max-width:500px;padding:0;overflow:hidden;background:#111;border:1px solid #333}
.pd-img-box{position:relative;width:100%;background:#000;overflow:hidden; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;}
.pd-img-box::-webkit-scrollbar {display: none;}
.pd-img-box img{min-width: 100%; aspect-ratio: 2772/1240; object-fit: contain; scroll-snap-align: center; cursor: pointer;}
.pd-img-box.sq img{aspect-ratio: 1/1; object-fit: cover;}
.pd-content{padding:20px;text-align:right}
.pd-content h2{font-size:1.3rem;color:var(--gold-hover);margin-bottom:8px;text-align:center}
.pd-desc{color:var(--muted);font-size:.9rem;margin-bottom:16px;text-align:center;line-height:1.6}
.pd-price-row{display:flex;justify-content:space-between;align-items:center;background:#0d0d0d;border:1px solid var(--line);padding:10px 14px;border-radius:10px;margin-bottom:16px;direction:ltr}
.pd-price-row b{color:var(--green);font-size:1.4rem}
.pd-price-row small{color:var(--gold)}
.pd-qty{display:flex;align-items:center;gap:12px}
.pd-qty label{font-size:.9rem;color:var(--gold);font-weight:700}
.pd-qty div{display:flex;align-items:center;gap:6px}
.pd-qty button{width:34px;height:34px;border-radius:8px;border:1px solid var(--gold);background:#111;color:var(--gold);font-size:1.2rem;cursor:pointer}
.pd-qty button:disabled{opacity:.3}
.pd-qty output{min-width:30px;text-align:center;font-weight:900;font-size:1.1rem;color:#fff}
.pd-actions{display:flex;gap:10px}
.pd-actions .btn{margin:0}
.pd-actions .btn.buy-now{flex:2}
.pd-actions .btn.close-btn{flex:1;background:#222;color:#fff;box-shadow:none;border:1px solid #333}

.steps{display:flex;gap:6px;margin-bottom:20px; background:#0d0d0d; border-radius:10px; padding:10px; border:1px solid var(--line);}
.steps span{flex:1;font-size:.75rem;color:var(--muted);text-align:center; padding:4px; border-radius:6px;}
.steps span.on{color:#000; background:var(--gold); font-weight:700;}
.sub2{color:var(--muted);font-size:.85rem;margin:-6px 0 14px}

.pay{display:flex;align-items:center;gap:12px;width:100%;margin-bottom:10px;padding:12px 14px;border-radius:12px;border:1px solid var(--line);border-right:4px solid var(--c,var(--gold));background:#1b1b1b;color:var(--text);cursor:pointer;text-align:right;transition:.2s}
.pay:hover{border-color:var(--c);background:#202020}
.pay .ic{width:44px;height:44px;display:grid;place-items:center;border-radius:10px;background:#000;flex:none}
.pay .tx{flex:1;display:flex;flex-direction:column}.pay .tx b{font-size:1rem}.pay .tx small{color:var(--muted);font-size:.78rem}
.pay .ch{color:var(--muted);font-size:1.6rem;line-height:1}
.pay.flexy{--c:#ff6b00}.pay.ccp{--c:#2f86ff}.pay.binance{--c:#f3ba2f}

.pinfo{background:#111;border:1px solid var(--gold);border-radius:8px;padding:14px;margin-bottom:14px;text-align:right;font-size:.9rem}
.pinfo h4{color:var(--gold);margin-bottom:8px;border-bottom:1px solid #333;padding-bottom:5px;display:flex;align-items:center;gap:8px}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:6px 0;background:#000;padding:8px;border-radius:6px;border:1px solid #222}
.row span{color:var(--gold-soft);font-weight:700;font-family:monospace;font-size:1rem;word-break:break-all;direction:ltr;text-align:left}
.copy{background:var(--gold);color:#000;border:0;padding:4px 10px;border-radius:5px;font-size:.8rem;cursor:pointer;font-weight:700;flex:none}
.warn{color:var(--red);font-weight:700;font-size:.83rem;margin-top:8px;text-align:center;border-top:1px dashed #444;padding-top:8px}
.field{margin-bottom:13px;text-align:right}
.field label{display:block;margin-bottom:4px;color:var(--gold);font-weight:700;font-size:.9rem}
.field input{width:100%;padding:11px;border-radius:8px;border:1px solid #333;background:#000;color:#fff}
.field input:focus{outline:none;border-color:var(--gold)}
.note{font-size:.78rem;color:var(--muted);margin-top:3px}
.err{background:rgba(255,77,77,.12);color:var(--red);padding:8px;border-radius:6px;margin-bottom:12px;display:none;font-size:.9rem}
.btns{display:flex;gap:10px;margin-top:16px}
.avatar{width:64px;height:64px;border-radius:50%;border:2px solid var(--gold);display:grid;place-items:center;font-size:1.8rem;margin:0 auto 8px;background:#111}
#toasts{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:2000;display:flex;flex-direction:column;gap:8px;width:92%;max-width:380px}
.toast{background:#1d1d1d;border:1px solid var(--gold);border-radius:10px;padding:11px 14px;font-weight:700;font-size:.9rem;animation:up .25s}
.toast.ok{border-color:var(--green)}.toast.bad{border-color:var(--red)}

footer{text-align:center;padding:24px 20px;border-top:1px solid #222;color:var(--muted);font-size:.85rem;display:flex;flex-direction:column;align-items:center;gap:12px}
.socials{display:flex;gap:12px;justify-content:center}
.social-btn{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--card);border:1px solid var(--line);color:var(--text);text-decoration:none;transition:.25s}
.social-btn:hover{transform:translateY(-3px)}
.social-btn.insta:hover{border-color:#E1306C;color:#E1306C;box-shadow:0 5px 15px rgba(225,48,108,.2)}
.social-btn.fb:hover{border-color:#1877F2;color:#1877F2;box-shadow:0 5px 15px rgba(24,119,242,.2)}
.social-btn.wa:hover{border-color:#25D366;color:#25D366;box-shadow:0 5px 15px rgba(37,211,102,.2)}
.social-btn svg{width:22px;height:22px;fill:currentColor}
