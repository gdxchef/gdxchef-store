  btn.disabled = !!off;
  btn.textContent = p.is_sold ? 'تم البيع | Sold' : (p.is_frozen ? 'مجمّد | Frozen' : 'شراء | Buy');
  
  openModal('detailsModal');
}

function updatePdQty(d) {
  pdQty = Math.min(10, Math.max(1, pdQty + d));
  $('pdQtyVal').textContent = pdQty;
  if(S.cur) {
    const isUsd = (kindOf(S.cur)==='account' && Number(S.cur.price_usd) > 0);
    if(isUsd) $('pdPriceVal').textContent = money(finalUsd(S.cur) * pdQty);
    else $('pdPriceVal').textContent = money(finalDa(S.cur) * pdQty);
  }
}

