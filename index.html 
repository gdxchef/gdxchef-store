<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0a0a0a">
<title>GDX CHEF STORE | متجر شحن الألعاب</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{--gold:#D4AF37;--gold-hover:#F3E5AB;--bg:#0a0a0a;--card:#161616;--line:#2a2a2a;--text:#F5F5F5;--muted:#A0A0A0;--green:#25D366;--red:#ff4d4d;--blue:#2f86ff}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Cairo',sans-serif}
body{background:var(--bg);color:var(--text);line-height:1.6;font-size:15px;min-height:100vh;display:flex;flex-direction:column}
header{background:rgba(10,10,10,.97);border-bottom:1px solid rgba(212,175,55,.3);padding:10px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px;position:sticky;top:0;z-index:100}
.logo{color:var(--gold);font-weight:900;font-size:1.2rem;white-space:nowrap;text-shadow: 0 0 10px rgba(212,175,55,0.3);}
nav{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}
nav button{background:none;border:0;border-bottom:2px solid transparent;color:var(--text);font-size:.88rem;font-weight:700;cursor:pointer;padding:6px 10px;white-space:nowrap;transition:.2s}
nav button:hover,nav button.active{color:var(--gold);border-color:var(--gold)}
.user-btn{width:40px;height:40px;flex:none;border-radius:50%;background:#111;border:2px solid var(--gold);display:grid;place-items:center;cursor:pointer}
.user-btn svg{width:20px;height:20px;fill:var(--gold)}
.user-btn.on{border-color:var(--green)}.user-btn.on svg{fill:var(--green)}
main{flex:1;width:100%;max-width:1000px;margin:0 auto;padding:18px 14px}
.page{display:none}.page.active{display:block}
.hero{background:linear-gradient(rgba(0,0,0,.86),rgba(0,0,0,.86)),url('https://images.unsplash.com/photo-1511512578047-dfb367046420?w=1200&q=70') center/cover;border:1px solid var(--gold);border-radius:14px;padding:60px 20px;text-align:center;margin-bottom:20px}
.hero h1{color:var(--gold);font-size:2.2rem;font-weight:900;margin-bottom:8px; letter-spacing:1px; text-transform: uppercase;}
.hero p{color:#ddd;margin-bottom:22px;font-size:1.05rem}
.btn{background:linear-gradient(135deg,#C9A227,#F3E5AB);color:#111;border:0;cursor:pointer;padding:12px;border-radius:10px;font-weight:800;width:100%;font-size:.95rem;transition:.2s}
.btn:active{transform:scale(.97)}
.btn.green{background:linear-gradient(45deg,#25D366,#1ebe5a);color:#fff}
.btn.gray{background:#333;color:#fff}
.btn.out{background:none;border:1px solid var(--red);color:var(--red)}
.btn.blue{background:linear-gradient(45deg,#2f86ff,#1c6de0);color:#fff}
.title{color:var(--text);margin:6px 0 20px;font-size:1.35rem;font-weight:900;text-align:center}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:768px){.grid{grid-template-columns:repeat(3,1fr);gap:16px}}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;position:relative}
.card img{width:100%;aspect-ratio:4/3;object-fit:cover;cursor:pointer;background:#000}
.info{padding:12px;text-align:center;display:flex;flex-direction:column;flex:1}
.info h3{color:var(--gold);font-size:.98rem;margin-bottom:4px}
.pnow b{font-size:1.3rem;color:var(--gold-hover)}
.pnow small{color:var(--gold);font-size:.75rem}
.pusd{color:var(--green);font-size:.85rem;font-weight:700;margin-top:2px;direction:ltr}
.off{position:absolute;top:8px;left:8px;z-index:1;background:var(--red);color:#fff;padding:2px 10px;border-radius:20px;font-weight:900;font-size:.8rem}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.93);z-index:1000;place-items:center;padding:10px}
.modal.open{display:grid}
.box{background:var(--card);border:1px solid var(--gold);border-radius:14px;padding:24px 18px;width:100%;max-width:560px;text-align:center;position:relative;max-height:92vh;overflow-y:auto}
/* زر الرجوع الاحترافي */
.back-btn {position:absolute;top:15px;right:15px;background:rgba(255,255,255,0.05);border:1px solid var(--line);color:var(--text);padding:8px 12px;border-radius:20px;cursor:pointer;font-weight:700;font-size:0.85rem;display:flex;align-items:center;gap:5px;transition:0.2s;}
.back-btn:hover {background:var(--gold);color:#000;}
.pay{display:flex;align-items:center;gap:12px;width:100%;margin-bottom:10px;padding:12px 14px;border-radius:12px;border:1px solid var(--line);background:#1b1b1b;color:var(--text);cursor:pointer;text-align:right}
.pay:hover{border-color:var(--gold);background:#202020}
.pay .ic{font-size:1.5rem;width:44px;height:44px;display:grid;place-items:center;border-radius:10px;background:#000;flex:none}
.field{margin-bottom:13px;text-align:right}
.field label{display:block;margin-bottom:4px;color:var(--gold);font-weight:700;font-size:.9rem}
.field input, .field select{width:100%;padding:11px;border-radius:8px;border:1px solid #333;background:#000;color:#fff}
.pinfo{background:#111;border:1px solid var(--gold);border-radius:8px;padding:14px;margin-bottom:14px;text-align:right;font-size:.9rem}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:6px 0;background:#000;padding:8px;border-radius:6px}
.copy{background:var(--gold);color:#000;border:0;padding:4px 10px;border-radius:5px;font-size:.8rem;cursor:pointer;font-weight:700}
#toasts{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:2000;display:flex;flex-direction:column;gap:8px;width:92%;max-width:380px}
.toast{background:#1d1d1d;border:1px solid var(--gold);border-radius:10px;padding:11px 14px;font-weight:700;font-size:.9rem}
</style>
</head>
<body>
<header>
  <div class="logo">GDX CHEF STORE</div>
  <nav id="nav">
    <button data-page="home" class="active">الرئيسية</button>
    <button data-page="games">شحن الألعاب</button>
    <button data-page="accounts">حسابات</button>
    <button data-page="wallet">المحفظة 💳</button>
    <button data-page="myOrders">طلباتي</button>
  </nav>
  <button class="user-btn" id="userBtn"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></button>
</header>

<main>
  <section id="page-home" class="page active">
    <div class="hero"><h1>GDX CHEF STORE</h1><p>شحن الألعاب وبيع الحسابات بأسعار مناسبة</p><button class="btn hero-btn" style="width:auto; padding:13px 34px; border-radius:30px;" data-page="games">تصفح المنتجات</button></div>
    <div class="grid" id="grid-home"></div>
  </section>
  
  <section id="page-games" class="page"><h2 class="title">شحن الألعاب</h2><div class="grid" id="grid-games"></div></section>
  <section id="page-accounts" class="page"><h2 class="title">حسابات</h2><div class="grid" id="grid-accounts"></div></section>
  <section id="page-myOrders" class="page"><h2 class="title">طلباتي</h2><div id="orders"></div></section>
  
  <!-- صفحة المحفظة الجديدة -->
  <section id="page-wallet" class="page">
    <h2 class="title">محفظتي</h2>
    <div style="background:var(--card); border:1px solid var(--gold); border-radius:14px; padding:20px; text-align:center; margin-bottom:20px;">
      <p style="color:var(--muted)">رصيدك الحالي</p>
      <h1 style="color:var(--gold); font-size:2.5rem; direction:ltr;" id="walletDa">0 DA</h1>
      <h3 style="color:var(--green); direction:ltr;" id="walletUsd">0.00 USD</h3>
    </div>
    <div class="box">
      <h3 style="color:var(--gold); margin-bottom:10px;">شحن المحفظة</h3>
      <p style="font-size:0.9rem; color:var(--muted); margin-bottom:15px;">اختر طريقة الدفع لشحن رصيدك.</p>
      <div style="display:flex; gap:10px;">
        <button class="btn blue" style="flex:1;" onclick="openChargeModal('CCP')">CCP / BaridiMob</button>
        <button class="btn" style="flex:1; background:#f3ba2f; color:#000;" onclick="openChargeModal('Binance')">Binance (USD)</button>
      </div>
    </div>
  </section>
</main>

<!-- Details Modal -->
<div class="modal" id="detailsModal"><div class="box" style="max-width:680px">
  <button class="back-btn" onclick="closeAll()">➔ رجوع</button>
  <h2 id="dName" style="margin-top:10px;"></h2>
  <div id="dDesc" class="specs" style="margin:15px 0;"></div>
  <div id="dPrice" style="margin-bottom:14px; font-size:1.5rem; color:var(--gold);"></div>
  <button class="btn green" id="dBuy">شراء</button>
</div></div>

<!-- Payment Method Modal -->
<div class="modal" id="payModal"><div class="box">
  <button class="back-btn" onclick="closeAll()">➔ رجوع</button>
  <h2 style="margin-top:10px;">اختر طريقة الدفع</h2>
  <p id="payProduct" style="margin-bottom:16px;font-weight:700"></p>
  <div id="payOptions"></div>
</div></div>

<!-- Receipt Modal -->
<div class="modal" id="receiptModal"><div class="box">
  <button class="back-btn" onclick="closeAll()">➔ رجوع</button>
  <h2 style="margin-top:10px;">إتمام الطلب</h2>
  <div id="payInfo" class="pinfo"></div>
  
  <div class="field" id="gameIdBox"><label>آيدي اللعبة (ID)</label><input id="gameId" placeholder="مثلاً 123456789"></div>
  <div class="field"><label>رقم الواتساب</label><input id="wa" placeholder="مثلاً 213562159983"></div>
  
  <!-- الحقول المالية (تتغير حسب العملة) -->
  <div class="field" id="amountDaBox"><label>المبلغ المدفوع (DA)</label><input id="amount" inputmode="decimal"></div>
  <div class="field" id="amountUsdBox" style="display:none;"><label>المبلغ المدفوع ($ USD)</label><input id="amountUsd" inputmode="decimal"></div>
  
  <div class="field"><label>صورة الوصل</label><input type="file" id="file" accept="image/*"></div>
  <button class="btn green" id="submitOrder">تأكيد الطلب</button>
</div></div>

<!-- Charge Wallet Modal (شحن المحفظة) -->
<div class="modal" id="chargeModal"><div class="box">
  <button class="back-btn" onclick="closeAll()">➔ رجوع</button>
  <h2 style="margin-top:10px;">شحن المحفظة - <span id="cMethodName"></span></h2>
  <div id="cPayInfo" class="pinfo"></div>
  
  <div class="field"><label>المبلغ المراد شحنه</label><input id="cAmount" inputmode="decimal"></div>
  <div class="field"><label>صورة الوصل</label><input type="file" id="cFile" accept="image/*"></div>
  <button class="btn green" id="submitCharge">إرسال طلب الشحن</button>
</div></div>

<!-- Auth Modals -->
<div class="modal" id="authModal"><div class="box">
  <button class="back-btn" onclick="closeAll()">➔ رجوع</button>
  <h2 id="authTitle" style="margin-top:10px;">تسجيل الدخول</h2>
  <div class="field"><label>البريد الإلكتروني</label><input type="email" id="email"></div>
  <div class="field"><label>كلمة المرور</label><input type="password" id="pass"></div>
  <button class="btn" id="authBtn">دخول</button>
  <p style="margin-top:14px;font-size:.9rem"><a href="#" id="authSwitch" style="color:var(--gold)">إنشاء حساب جديد</a></p>
</div></div>

<div class="modal" id="profileModal"><div class="box">
  <button class="back-btn" onclick="closeAll()">➔ رجوع</button>
  <h2 style="margin-top:10px;">حسابي</h2>
  <p id="profileEmail" style="margin-bottom:18px;"></p>
  <button class="btn out" id="logout">تسجيل الخروج</button>
</div></div>

<div id="toasts"></div>
<footer>&copy; 2026 GDX CHEF STORE. جميع الحقوق محفوظة.</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL='https://focoxfmdmcjofswmgkco.supabase.co';
const SUPABASE_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZvY294Zm1kbWNqb2Zzd21na2NvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM5MjMzMTYsImV4cCI6MjEwOTQ5OTMxNn0.H2At_v8QhrO89001o-y0nV0sXf3Ve6nSgUcqI3RtEq8';
const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money=n=>Number(n||0).toLocaleString('en-US');
const isAccount=c=>String(c).startsWith('accounts');

const S={user:null,products:new Map(),wallet:{da:0, usd:0},cur:null,method:'',currency:'DA',busy:false};

function toast(msg,type=''){const t=document.createElement('div');t.className='toast '+type;t.textContent=msg;$('toasts').appendChild(t);setTimeout(()=>t.remove(),3500)}
const openModal=id=>$(id).classList.add('open');
function closeAll(){document.querySelectorAll('.modal.open').forEach(m=>m.classList.remove('open'))}

function showPage(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='page-'+id));
  window.scrollTo({top:0});
  if(id==='myOrders')loadOrders();
  if(id==='wallet')loadWallet();
}

const onSale=p=>Number(p.discount_price)>0&&Number(p.discount_price)<Number(p.price);
function priceHtml(p){
  let html = `<div class="pnow"><b>${money(onSale(p)?p.discount_price:p.price)}</b> <small>DA</small></div>`;
  if(p.price_usd > 0) {
    html += `<div class="pusd">≈ $${onSale(p)?p.discount_price_usd:p.price_usd}</div>`;
  }
  return html;
}
function cardHtml(p){
  const img=p.image_url||'https://images.unsplash.com/photo-1552820728-8b83bb6b773f?w=500&q=70';
  return `<article class="card">${onSale(p)?`<div class="off">-${Math.round((1-p.discount_price/p.price)*100)}%</div>`:''}
  <img src="${esc(img)}" onclick="showDetails('${p.id}')">
  <div class="info"><h3>${esc(p.name)}</h3><div class="price">${priceHtml(p)}</div>
  <button class="btn" onclick="buy('${p.id}')">شراء</button></div></article>`;
}
function renderGrid(id,list){$(id).innerHTML=list.length?list.map(cardHtml).join(''):`<div class="empty">لا توجد منتجات.</div>`}
function renderProducts(){
  const all=[...S.products.values()];
  renderGrid('grid-home',all.slice(0,4));
  renderGrid('grid-games',all.filter(p=>!isAccount(p.category)));
  renderGrid('grid-accounts',all.filter(p=>isAccount(p.category)));
}
async function loadProducts(){
  const{data}=await db.from('products').select('*').eq('is_hidden',false).order('created_at',{ascending:false});
  S.products=new Map((data||[]).map(p=>[String(p.id),p]));
  renderProducts();
}

function showDetails(id){
  const p = S.products.get(String(id)); if(!p) return;
  $('dName').textContent=p.name;
  $('dDesc').innerHTML = String(p.description||'').replace(/\n/g, '<br>');
  $('dPrice').innerHTML = priceHtml(p);
  $('dBuy').onclick=()=>{closeAll(); buy(id)};
  openModal('detailsModal');
}

async function buy(id){
  const p = S.products.get(String(id)); if(!p) return;
  if(!S.user){toast('سجّل الدخول أولاً');openModal('authModal');return}
  S.cur=p;
  
  // بناء خيارات الدفع
  let opts = `<button class="pay" onclick="selectPayment('Wallet')"><span class="ic">💳</span><span>الدفع من المحفظة</span></button>`;
  opts += `<button class="pay" onclick="selectPayment('CCP')"><span class="ic">🏦</span><span>CCP / BaridiMob</span></button>`;
  if(!isAccount(p.category)) opts += `<button class="pay" onclick="selectPayment('Flexy')"><span class="ic">📱</span><span>Flexy</span></button>`;
  opts += `<button class="pay" onclick="selectPayment('Binance')"><span class="ic">🪙</span><span>Binance (USD)</span></button>`;
  
  $('payProduct').innerHTML = `${esc(p.name)}`;
  $('payOptions').innerHTML = opts;
  openModal('payModal');
}

async function selectPayment(m){
  S.method = m;
  closeAll();
  
  if(m === 'Wallet') {
    // التحقق من الرصيد
    await loadWallet();
    const priceDa = onSale(S.cur) ? S.cur.discount_price : S.cur.price;
    if(S.wallet.da < priceDa) {
      toast('رصيدك غير كافٍ. يرجى شحن المحفظة أولاً.', 'bad');
      return showPage('wallet');
    }
    if(!confirm(`سيتم خصم ${money(priceDa)} DA من محفظتك. هل أنت متأكد؟`)) return;
    
    // إتمام الشراء مباشرة من المحفظة
    S.busy=true;
    const newBalance = S.wallet.da - priceDa;
    await db.from('wallets').update({balance_da: newBalance}).eq('user_email', S.user.email);
    await db.from('orders').insert({
      user_email: S.user.email, product_name: S.cur.name, payment_method: 'Wallet',
      amount_paid: priceDa, status: 'approved' // مقبول تلقائياً
    });
    toast('تم الشراء بنجاح! تم خصم المبلغ من محفظتك.', 'ok');
    loadWallet(); S.busy=false;
    return;
  }
  
  // الدفع اليدوي (CCP, Flexy, Binance)
  S.currency = m === 'Binance' ? 'USD' : 'DA';
  $('amountDaBox').style.display = S.currency === 'DA' ? 'block' : 'none';
  $('amountUsdBox').style.display = S.currency === 'USD' ? 'block' : 'none';
  $('gameIdBox').style.display = isAccount(S.cur.category) ? 'none' : 'block';
  
  const s = await db.from('settings').select('*').eq('id',1).single();
  const data = s.data;
  if(m === 'Flexy') $('payInfo').innerHTML = `<p>رقم Flexy:</p> <h3>${esc(data.flexy_number)}</h3>`;
  else if(m === 'CCP') $('payInfo').innerHTML = `<p>CCP:</p> <h3>${esc(data.ccp_number)}</h3> <p>الاسم: ${esc(data.ccp_name)}</p>`;
  else if(m === 'Binance') $('payInfo').innerHTML = `<p>Binance ID:</p> <h3>${esc(data.binance_id)}</h3> <p>البريد: ${esc(data.binance_email)}</p>`;
  
  openModal('receiptModal');
}

async function submitOrder(){
  if(S.busy) return;
  const amountDa = $('amount').value.trim();
  const amountUsd = $('amountUsd').value.trim();
  const file = $('file').files[0];
  
  if(S.currency === 'DA' && !amountDa) return toast('أدخل المبلغ بالدينار', 'bad');
  if(S.currency === 'USD' && !amountUsd) return toast('أدخل المبلغ بالدولار', 'bad');
  if(!file) return toast('ارفع صورة الوصل', 'bad');
  
  S.busy = true;
  const btn = $('submitOrder'); btn.textContent = 'جاري الإرسال...';
  
  try {
    const ext = (file.type.split('/')[1] || 'jpg');
    const name = `receipt_${Date.now()}.${ext}`;
    await db.storage.from('receipts').upload(name, file);
    const url = db.storage.from('receipts').getPublicUrl(name).data.publicUrl;
    
    await db.from('orders').insert({
      user_email: S.user.email, product_name: S.cur.name, payment_method: S.method,
      amount_paid: S.currency === 'DA' ? amountDa : null,
      amount_paid_usd: S.currency === 'USD' ? amountUsd : null,
      receipt_url: url, game_id: $('gameId').value, whatsapp: $('wa').value
    });
    
    toast('تم إرسال الطلب، سنراجعه قريباً', 'ok');
    closeAll(); showPage('myOrders');
  } catch(e) { toast('خطأ: ' + e.message, 'bad'); }
  finally { S.busy = false; btn.textContent = 'تأكيد الطلب'; }
}

/* المحفظة */
async function loadWallet(){
  if(!S.user) return;
  let { data } = await db.from('wallets').select('*').eq('user_email', S.user.email).single();
  if(!data) {
    // إنشاء محفظة إذا لم توجد
    await db.from('wallets').insert({user_email: S.user.email, balance_da: 0, balance_usd: 0});
    data = { balance_da: 0, balance_usd: 0 };
  }
  S.wallet = { da: Number(data.balance_da), usd: Number(data.balance_usd) };
  if($('walletDa')) $('walletDa').textContent = money(S.wallet.da) + ' DA';
  if($('walletUsd')) $('walletUsd').textContent = S.wallet.usd.toFixed(2) + ' USD';
}

function openChargeModal(method){
  if(!S.user) { toast('سجل الدخول أولاً'); return openModal('authModal'); }
  $('cMethodName').textContent = method;
  $('cPayInfo').innerHTML = method === 'CCP' 
    ? `<p>قم بالتحويل إلى CCP: <br><strong>${/* ضع رقم CCP هنا أو اجلبه من DB */ '---'}</strong></p>`
    : `<p>قم بالتحويل إلى Binance ID: <br><strong>${/* ضع رقم Binance هنا */ '---'}</strong></p>`;
  
  $('submitCharge').onclick = async () => {
    const amt = $('cAmount').value.trim();
    const f = $('cFile').files[0];
    if(!amt || !f) return toast('أدخل المبلغ والوصل', 'bad');
    
    const name = `charge_${Date.now()}.jpg`;
    await db.storage.from('receipts').upload(name, f);
    const url = db.storage.from('receipts').getPublicUrl(name).data.publicUrl;
    
    await db.from('wallet_requests').insert({
      user_email: S.user.email, amount: amt,
      currency: method === 'Binance' ? 'USD' : 'DA',
      method: method, receipt_url: url
    });
    toast('تم إرسال طلب الشحن، انتظر الموافقة', 'ok');
    closeAll();
  };
  openModal('chargeModal');
}

async function loadOrders(){
  if(!S.user) return;
  const { data } = await db.from('orders').select('*').eq('user_email', S.user.email).order('created_at', {ascending:false});
  const box = $('orders');
  if(!data || !data.length) { box.innerHTML = '<div class="empty">لا توجد طلبات.</div>'; return; }
  box.innerHTML = data.map(o => `<div class="box" style="text-align:right; margin-bottom:10px;">
    <span style="background:${o.status==='approved'?'var(--green)':'var(--yellow)'}; padding:2px 8px; border-radius:10px; font-size:0.8rem;">${o.status==='approved'?'مقبول':'قيد الانتظار'}</span>
    <h3 style="color:var(--gold); margin-top:5px;">${esc(o.product_name)}</h3>
    <p style="font-size:0.9rem;">طريقة الدفع: ${esc(o.payment_method)}</p>
    ${o.amount_paid ? `<p>المبلغ: ${o.amount_paid} DA</p>` : ''}
    ${o.amount_paid_usd ? `<p>المبلغ: $${o.amount_paid_usd}</p>` : ''}
  </div>`).join('');
}

async function auth(){
  const email = $('email').value, pass = $('pass').value;
  const { error } = await db.auth.signInWithPassword({email, password: pass});
  if(error) toast(error.message, 'bad');
  else { closeAll(); toast('تم الدخول', 'ok'); }
}

db.auth.onAuthStateChange((_e, session) => {
  S.user = session ? session.user : null;
  $('userBtn').classList.toggle('on', !!S.user);
  if(S.user) loadWallet();
});
$('userBtn').onclick = () => S.user ? openModal('profileModal') : openModal('authModal');
$('authBtn').onclick = auth;
$('logout').onclick = () => { db.auth.signOut(); closeAll(); showPage('home'); };
$('submitOrder').onclick = submitOrder;

loadProducts();
</script>
</body>
</html>