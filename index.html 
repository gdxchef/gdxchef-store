// Sub categories (Level 2) or Products (Level 3)
function openCat(id){
  const c=S.cats.get(String(id));if(!c)return;
  S.catId=String(id);
  const children=[...S.cats.values()].filter(x=>x.parent_id===c.id);
  
  $('catTitle').innerHTML = `<span class="en">${c.kind==='account'?'Accounts':'Top Up'}</span>${esc(c.name)}`;
  
  const current=document.querySelector('.page.active');
  const prevPage=current?current.id.replace('page-',''):'topup';
  $('catBack').dataset.page=(prevPage==='cat'||prevPage==='myOrders')?'topup':prevPage;
  
  if(children.length > 0) {
    $('q-cat').style.display='none';
    $('products-container').innerHTML = `<div class="grid-games">${children.map(c=>{
      const img=safeUrl(c.image_url);
      const n=[...S.products.values()].filter(p=>String(p.category_id)===String(c.id)).length;
      return `<button class="tile" data-act="cat" data-id="${esc(c.id)}">${img?`<img src="${esc(img)}" alt="" loading="lazy">`:`<span class="ti">🎮</span>`}<b>${esc(c.name)}</b><small>${n} عرض</small></button>`;
    }).join('')}</div>`;
