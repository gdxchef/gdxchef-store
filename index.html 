<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="GDX CHEF STORE: متجر جزائري لشحن الألعاب وبيع حسابات Free Fire وeFootball. دفع عبر Flexy وCCP وBinance.">
<meta name="theme-color" content="#0a0a0a">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%91%91%3C/text%3E%3C/svg%3E">
<title>GDX CHEF STORE | متجر شحن الألعاب</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{--gold:#D4AF37;--gold-hover:#F3E5AB;--gold-soft:#E8D48A;--bg:#0a0a0a;--card:#161616;--line:#2a2a2a;--text:#F5F5F5;--muted:#A0A0A0;--yellow:#f39c12;--green:#25D366;--red:#ff4d4d}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Cairo',sans-serif}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);line-height:1.6;font-size:15px;min-height:100vh;display:flex;flex-direction:column}
button{font-family:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
header{background:rgba(10,10,10,.97);backdrop-filter:blur(10px);border-bottom:1px solid rgba(212,175,55,.3);padding:10px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px;position:sticky;top:0;z-index:100}
.logo{color:var(--gold);font-weight:900;font-size:1.15rem;white-space:nowrap}
nav{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
nav button{background:none;border:0;border-bottom:2px solid transparent;color:var(--text);font-size:.88rem;font-weight:700;cursor:pointer;padding:6px 10px;white-space:nowrap;transition:.2s}
nav button:hover,nav button.active{color:var(--gold);border-color:var(--gold)}
.user-btn{width:40px;height:40px;flex:none;border-radius:50%;background:#111;border:2px solid var(--gold);display:grid;place-items:center;cursor:pointer;transition:.2s}
.user-btn svg{width:20px;height:20px;fill:var(--gold)}
.user-btn.on{border-color:var(--green)}.user-btn.on svg{fill:var(--green)}
main{flex:1;width:100%;max-width:1000px;margin:0 auto;padding:18px 14px}
.page{display:none}.page.active{display:block}
.hero{background:linear-gradient(rgba(0,0,0,.86),rgba(0,0,0,.86)),url('https://images.unsplash.com/photo-1511512578047-dfb367046420?w=1200&q=70') center/cover;border:1px solid var(--gold);border-radius:14px;padding:60px 20px;text-align:center;margin-bottom:20px}
.hero h1{color:var(--gold);font-size:2rem;font-weight:900;margin-bottom:8px}
.hero p{color:#ddd;margin-bottom:22px;font-size:1.05rem}
.trust{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:18px}
.trust span{border:1px solid var(--line);border-radius:20px;padding:3px 12px;font-size:.8rem;color:var(--gold-soft)}
.btn{background:linear-gradient(45deg,#D4AF37,#F3E5AB);color:#000;border:0;cursor:pointer;padding:11px;border-radius:8px;font-weight:700;width:100%;font-size:.95rem;transition:.2s}
.btn:hover{filter:brightness(1.08)}
.btn:disabled{opacity:.6;cursor:not-allowed}
.btn.hero-btn{width:auto;padding:13px 34px;border-radius:30px;font-weight:900}
.btn.green{background:linear-gradient(45deg,#25D366,#1ebe5a);color:#fff}
.btn.gray{background:#333;color:#fff}
.btn.out{background:none;border:1px solid var(--red);color:var(--red)}
.ads{display:flex;overflow-x:auto;gap:10px;margin-bottom:26px;padding-bottom:8px;scroll-snap-type:x mandatory}
.ads img{height:120px;border-radius:10px;border:1px solid var(--gold);scroll-snap-align:start}
.title{color:var(--text);margin:6px 0 20px;font-size:1.35rem;font-weight:900;text-align:center}
.title::after{content:'';display:block;width:56px;height:3px;background:var(--gold);margin:6px auto 0;border-radius:2px}
.filters{display:flex;gap:8px;margin-bottom:16px}
.filters input{flex:1;padding:11px 14px;border-radius:25px;border:1px solid var(--line);background:#000;color:#fff;font-size:.95rem}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:768px){.grid{grid-template-columns:repeat(3,1fr);gap:16px}}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;position:relative;transition:border-color .2s,transform .2s}
.card:hover{border-color:var(--gold);transform:translateY(-3px)}
.card img{width:100%;aspect-ratio:4/3;object-fit:cover;cursor:pointer;background:#000}
.sold{position:absolute;top:8px;right:8px;background:var(--red);color:#fff;padding:2px 10px;border-radius:20px;font-weight:700;font-size:.78rem}
.info{padding:12px;text-align:center;display:flex;flex-direction:column;flex:1}
.info h3{color:var(--gold);font-size:.98rem;margin-bottom:4px}
.info p{color:var(--muted);font-size:.8rem;margin-bottom:8px;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.price{margin-bottom:10px;font-weight:900;font-size:1.15rem;color:var(--gold-hover)}
.price s{color:var(--red);font-size:.85rem;font-weight:400;margin-left:6px}
.price b{color:var(--green)}
.skeleton{height:290px;border-radius:12px;background:linear-gradient(90deg,#161616 25%,#222 50%,#161616 75%);background-size:200% 100%;animation:sk 1.3s infinite}
@keyframes sk{to{background-position:-200% 0}}
.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:30px 10px}
.order{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:12px}
.badge{padding:3px 12px;border-radius:20px;font-size:.78rem;font-weight:700;display:inline-block;margin-bottom:8px}
.badge.pending{background:var(--yellow);color:#000}.badge.approved{background:var(--green);color:#fff}.badge.rejected{background:var(--red);color:#fff}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.93);z-index:1000;place-items:center;padding:10px}
.modal.open{display:grid}
.box{background:var(--card);border:1px solid var(--gold);border-radius:14px;padding:24px 18px;width:100%;max-width:560px;text-align:center;position:relative;max-height:92vh;overflow-y:auto;animation:up .25s ease}
@keyframes up{from{transform:translateY(30px);opacity:0}}
.x{position:absolute;top:10px;left:14px;background:none;border:0;color:var(--muted);font-size:1.8rem;cursor:pointer;line-height:1}
.x:hover{color:var(--gold)}
.box h2{color:var(--gold);margin-bottom:14px}
.pay{display:block;width:100%;margin-bottom:10px;padding:13px;border-radius:8px;border:0;font-weight:700;cursor:pointer;color:#fff;font-size:1rem}
.pay.flexy{background:linear-gradient(45deg,#ff6b00,#ff8c33)}.pay.ccp{background:linear-gradient(45deg,#0055a4,#0077e6)}.pay.binance{background:linear-gradient(45deg,#f3ba2f,#f7d15d);color:#000}
.gallery{display:flex;overflow-x:auto;gap:10px;margin-bottom:16px;scroll-snap-type:x mandatory}
.gallery img{height:340px;min-width:100%;object-fit:contain;border-radius:8px;border:1px solid var(--line);scroll-snap-align:center;background:#000}
.pinfo{background:#111;border:1px solid var(--gold);border-radius:8px;padding:14px;margin-bottom:14px;text-align:right;font-size:.9rem}
.pinfo h4{color:var(--gold);margin-bottom:8px;border-bottom:1px solid #333;padding-bottom:5px}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:6px 0;background:#000;padding:8px;border-radius:6px;border:1px solid #222}
.row span{color:var(--gold-soft);font-weight:700;font-family:monospace;font-size:1rem;word-break:break-all}
.copy{background:var(--gold);color:#000;border:0;padding:4px 10px;border-radius:5px;font-size:.8rem;cursor:pointer;font-weight:700;flex:none}
.warn{color:var(--red);font-weight:700;font-size:.83rem;margin-top:8px;text-align:center;border-top:1px dashed #444;padding-top:8px}
.field{margin-bottom:13px;text-align:right}
.field label{display:block;margin-bottom:4px;color:var(--gold);font-weight:700;font-size:.9rem}
.field input{width:100%;padding:11px;border-radius:8px;border:1px solid #333;background:#000;color:#fff}
.field input:focus{outline:none;border-color:var(--gold)}
.note{font-size:.78rem;color:var(--muted);margin-top:3px}
.err{background:rgba(255,77,77,.12);color:var(--red);padding:8px;border-radius:6px;margin-bottom:12px;display:none;font-size:.9rem}
.btns{display:flex;gap:10px;margin-top:16px}
#toasts{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:2000;display:flex;flex-direction:column;gap:8px;width:92%;max-width:380px}
.toast{background:#1d1d1d;border:1px solid var(--gold);border-radius:10px;padding:11px 14px;font-weight:700;font-size:.9rem;animation:up .25s}
.toast.ok{border-color:var(--green)}.toast.bad{border-color:var(--red)}
footer{text-align:center;padding:18px;border-top:1px solid #222;color:var(--muted);font-size:.85rem}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header>
  <div class="logo">GDX CHEF STORE</div>
  <nav id="nav">
    <button data-page="home" class="active">الرئيسية</button>
    <button data-page="games">شحن الألعاب</button>
    <button data-page="accounts">حسابات</button>
    <button data-page="myOrders">طلباتي</button>
  </nav>
  <button class="user-btn" id="userBtn" aria-label="حسابي"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></button>
</header>

<main>
  <section id="page-home" class="page active">
    <div class="hero">
      <h1>GDX CHEF STORE</h1>
      <p>شحن الألعاب وبيع الحسابات بأسعار مناسبة</p>
      <button class="btn hero-btn" data-page="games">تصفح المنتجات</button>
      <div class="trust"><span>دفع عبر Flexy وCCP وBinance</span><span>مراجعة الطلب يدوياً</span><span>تتبع طلباتك من حسابك</span></div>
    </div>
    <div class="ads" id="ads"></div>
    <h2 class="title">أحدث المنتجات</h2>
    <div class="grid" id="grid-home"></div>
  </section>
  <section id="page-games" class="page"><h2 class="title">شحن الألعاب</h2>
    <div class="filters"><input type="search" id="q-games" placeholder="ابحث عن لعبة..."></div>
    <div class="grid" id="grid-games"></div></section>
  <section id="page-accounts" class="page"><h2 class="title">حسابات</h2>
    <div class="filters"><input type="search" id="q-accounts" placeholder="ابحث عن حساب..."></div>
    <div class="grid" id="grid-accounts"></div></section>
  <section id="page-myOrders" class="page"><h2 class="title">طلباتي</h2><div id="orders"></div></section>
</main>

<div class="modal" id="detailsModal"><div class="box" style="max-width:680px">
  <button class="x" data-close aria-label="إغلاق">&times;</button>
  <h2 id="dName"></h2>
  <p id="dDesc" style="color:var(--muted);margin-bottom:14px;text-align:right;white-space:pre-line"></p>
  <div class="gallery" id="gallery"></div>
  <div id="dPrice" class="price" style="font-size:1.6rem;margin-bottom:14px"></div>
  <button class="btn green" id="dBuy">شراء</button>
</div></div>

<div class="modal" id="payModal"><div class="box">
  <button class="x" data-close aria-label="إغلاق">&times;</button>
  <h2>اختر طريقة الدفع</h2>
  <p id="payProduct" style="margin-bottom:16px;font-weight:700"></p>
  <div id="payOptions"></div>
</div></div>

<div class="modal" id="receiptModal"><div class="box">
  <button class="x" data-close aria-label="إغلاق">&times;</button>
  <h2>إتمام الطلب</h2>
  <div id="payInfo" class="pinfo"></div>
  <div class="field" id="gameIdBox" style="display:none"><label for="gameId">آيدي اللعبة (ID)</label><input id="gameId" inputmode="numeric" autocomplete="off" placeholder="مثلاً 123456789"><div class="note">تحقق من الآيدي قبل الإرسال، المتجر غير مسؤول عن الآيدي الخاطئ.</div></div>
  <div class="field"><label for="wa">رقم الواتساب</label><input id="wa" inputmode="tel" autocomplete="tel" placeholder="مثلاً 213562159983"><div class="note">بالصيغة الدولية بدون + (للتواصل معك)</div></div>
  <div class="field"><label for="amount">المبلغ المدفوع</label><input id="amount" inputmode="decimal" placeholder="مثلاً 1000"></div>
  <div class="field"><label for="file">صورة الوصل</label><input type="file" id="file" accept="image/*"><div class="note">صورة بحجم أقصاه 5 ميغابايت</div></div>
  <div class="btns"><button class="btn gray" data-close>رجوع</button><button class="btn green" id="submitOrder">تأكيد الطلب</button></div>
</div></div>

<div class="modal" id="authModal"><div class="box">
  <button class="x" data-close aria-label="إغلاق">&times;</button>
  <h2 id="authTitle">تسجيل الدخول</h2>
  <div id="authErr" class="err"></div>
  <div class="field"><label for="email">البريد الإلكتروني</label><input type="email" id="email" autocomplete="email"></div>
  <div class="field"><label for="pass">كلمة المرور</label><input type="password" id="pass" autocomplete="current-password"><div class="note" id="passNote" style="display:none">6 أحرف على الأقل</div></div>
  <button class="btn" id="authBtn">دخول</button>
  <p style="margin-top:14px;font-size:.9rem"><span id="authText">ليس لديك حساب؟</span> <a href="#" id="authSwitch" style="color:var(--gold)">أنشئ حساباً</a></p>
</div></div>

<div class="modal" id="profileModal"><div class="box">
  <button class="x" data-close aria-label="إغلاق">&times;</button>
  <h2>حسابي</h2>
  <p id="profileEmail" style="margin-bottom:18px;word-break:break-all"></p>
  <button class="btn out" id="logout">تسجيل الخروج</button>
</div></div>

<div id="toasts" aria-live="polite"></div>
<footer>&copy; <span id="year"></span> GDX CHEF STORE. جميع الحقوق محفوظة.</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL='https://focoxfmdmcjofswmgkco.supabase.co';
const SUPABASE_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZvY294Zm1kbWNqb2Zzd21na2NvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM5MjMzMTYsImV4cCI6MjEwOTQ5OTMxNn0.H2At_v8QhrO89001o-y0nV0sXf3Ve6nSgUcqI3RtEq8';
const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safeUrl=u=>/^https:\/\//i.test(u||'')?u:'';
const money=n=>Number(n||0).toLocaleString('en-US');
const FALLBACK='https://images.unsplash.com/photo-1552820728-8b83bb6b773f?w=500&q=70';
const isAccount=c=>String(c).startsWith('accounts');

const S={user:null,signUp:false,products:new Map(),settings:null,cur:null,method:'',busy:false};

function toast(msg,type=''){const t=document.createElement('div');t.className='toast '+type;t.textContent=msg;$('toasts').appendChild(t);setTimeout(()=>t.remove(),3500)}
const openModal=id=>$(id).classList.add('open');
const closeModal=id=>$(id).classList.remove('open');
function closeAll(){document.querySelectorAll('.modal.open').forEach(m=>m.classList.remove('open'))}

/* التنقل */
function showPage(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='page-'+id));
  document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));
  window.scrollTo({top:0});
  if(id==='myOrders')loadOrders();
}

/* المنتجات */
function cardHtml(p){
  const price=p.discount_price>0?`<s>${money(p.price)} DA</s><b>${money(p.discount_price)} DA</b>`:`${money(p.price)} DA`;
  const img=safeUrl(p.image_url)||FALLBACK;
  return `<article class="card">${p.is_sold?'<div class="sold">تم البيع</div>':''}
  <img src="${esc(img)}" alt="${esc(p.name)}" loading="lazy" data-act="details" data-id="${esc(p.id)}" onerror="this.onerror=null;this.src='${FALLBACK}'">
  <div class="info"><h3>${esc(p.name)}</h3><p>${esc(p.description)}</p><div class="price">${price}</div>
  <button class="btn" ${p.is_sold?'disabled':''} data-act="buy" data-id="${esc(p.id)}">${p.is_sold?'تم البيع':'شراء'}</button></div></article>`;
}
function renderGrid(id,list,msg){$(id).innerHTML=list.length?list.map(cardHtml).join(''):`<div class="empty">${msg}</div>`}
function renderProducts(){
  const all=[...S.products.values()];
  const q=k=>$('q-'+k).value.trim().toLowerCase();
  const match=(p,k)=>!q(k)||(p.name+' '+(p.description||'')).toLowerCase().includes(q(k));
  renderGrid('grid-home',all.slice(0,4),'لا توجد منتجات حالياً.');
  renderGrid('grid-games',all.filter(p=>!isAccount(p.category)&&match(p,'games')),'لا توجد نتائج.');
  renderGrid('grid-accounts',all.filter(p=>isAccount(p.category)&&match(p,'accounts')),'لا توجد نتائج.');
}
async function loadProducts(){
  ['grid-home','grid-games','grid-accounts'].forEach(id=>$(id).innerHTML='<div class="skeleton"></div><div class="skeleton"></div>');
  const{data,error}=await db.from('products').select('*').eq('is_hidden',false).order('created_at',{ascending:false});
  if(error){['grid-home','grid-games','grid-accounts'].forEach(id=>$(id).innerHTML='<div class="empty">تعذر تحميل المنتجات. <a href="#" data-act="retry" style="color:var(--gold)">إعادة المحاولة</a></div>');return}
  S.products=new Map((data||[]).map(p=>[String(p.id),p]));
  renderProducts();
}
async function loadAds(){
  const{data}=await db.from('ads').select('image_url').eq('is_active',true);
  const box=$('ads');const list=(data||[]).filter(a=>safeUrl(a.image_url));
  if(!list.length){box.style.display='none';return}
  box.innerHTML=list.map(a=>`<img src="${esc(a.image_url)}" alt="إعلان" loading="lazy">`).join('');
}
async function loadSettings(){
  if(!S.user){S.settings=null;return}
  const{data,error}=await db.from('settings').select('*').eq('id',1).single();
  S.settings=error?null:data;
}

/* تفاصيل المنتج */
function showDetails(p){
  $('dName').textContent=p.name;$('dDesc').textContent=p.description||'';
  $('dPrice').innerHTML=p.discount_price>0?`<s>${money(p.price)} DA</s><b>${money(p.discount_price)} DA</b>`:`${money(p.price)} DA`;
  const imgs=[p.image_url,...(Array.isArray(p.images)?p.images:[])].map(safeUrl).filter(Boolean);
  $('gallery').innerHTML=(imgs.length?imgs:[FALLBACK]).map(u=>`<img src="${esc(u)}" alt="${esc(p.name)}" loading="lazy">`).join('');
  const b=$('dBuy');b.disabled=!!p.is_sold;b.textContent=p.is_sold?'تم البيع':'شراء';
  b.onclick=()=>{closeModal('detailsModal');buy(p)};
  openModal('detailsModal');
}

/* الشراء والدفع */
function buy(p){
  if(p.is_sold){toast('هذا المنتج تم بيعه بالفعل','bad');return}
  if(!S.user){toast('سجّل الدخول أولاً');openModal('authModal');return}
  S.cur=p;
  $('payProduct').textContent=p.name;
  const opts=isAccount(p.category)?['CCP','Binance']:['Flexy','CCP','Binance'];
  const label={Flexy:'Flexy',CCP:'CCP / BaridiMob',Binance:'Binance'};
  $('payOptions').innerHTML=opts.map(m=>`<button class="pay ${m.toLowerCase()}" data-act="pay" data-m="${m}">${label[m]}</button>`).join('');
  openModal('payModal');
}
const copyRow=(v,l='نسخ')=>`<div class="row"><span>${esc(v)}</span><button class="copy" data-copy="${esc(v)}">${l}</button></div>`;
async function selectPayment(m){
  S.method=m==='CCP'?'CCP / BaridiMob':m;
  closeModal('payModal');
  if(!S.settings)await loadSettings();
  const s=S.settings,box=$('payInfo');
  if(!s)box.innerHTML='<p style="color:var(--red)">تعذر تحميل معلومات الدفع. حدّث الصفحة وأعد المحاولة.</p>';
  else if(m==='Flexy')box.innerHTML=`<h4>الدفع عبر Flexy</h4>${copyRow(s.flexy_number)}<p class="note" style="text-align:center">حوّل المبلغ إلى الرقم أعلاه.</p>`;
  else if(m==='CCP')box.innerHTML=`<h4>الدفع عبر CCP / BaridiMob</h4><p>الاسم: <strong>${esc(s.ccp_name)}</strong></p>${copyRow(s.ccp_number,'نسخ CCP')}<p>المفتاح (Clé): <strong>${esc(s.ccp_key)}</strong></p>${copyRow(s.ccp_rib,'نسخ RIB')}<div class="warn">📌 الدفع بهذه الطريقة يتوقف على الساعة 9 ليلاً</div>`;
  else box.innerHTML=`<h4>الدفع عبر Binance</h4><p>البريد: <strong>${esc(s.binance_email)}</strong></p>${copyRow(s.binance_id)}<p class="note" style="text-align:center">حوّل المبلغ بالدولار عبر Binance.</p>`;
  $('gameIdBox').style.display=isAccount(S.cur.category)?'none':'block';
  openModal('receiptModal');
}
async function copyText(t){
  try{await navigator.clipboard.writeText(t)}catch{const a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();document.execCommand('copy');a.remove()}
  toast('تم النسخ','ok');
}
async function submitOrder(){
  if(S.busy)return;
  const amount=$('amount').value.trim().replace(',','.'),gameId=$('gameId').value.trim(),wa=$('wa').value.replace(/[\s+\-]/g,''),file=$('file').files[0];
  const topUp=!isAccount(S.cur.category);
  if(topUp&&!/^[A-Za-z0-9_\-]{4,30}$/.test(gameId))return toast('أدخل آيدي اللعبة بشكل صحيح','bad');
  if(!/^\d{8,15}$/.test(wa))return toast('رقم الواتساب غير صحيح (أرقام فقط)','bad');
  if(!(Number(amount)>0))return toast('أدخل المبلغ المدفوع','bad');
  if(!file)return toast('ارفع صورة الوصل','bad');
  if(!file.type.startsWith('image/'))return toast('الملف يجب أن يكون صورة','bad');
  if(file.size>5*1024*1024)return toast('حجم الصورة أكبر من 5 ميغابايت','bad');
  const btn=$('submitOrder');S.busy=true;btn.disabled=true;btn.textContent='جاري الإرسال...';
  try{
    const ext=(file.type.split('/')[1]||'jpg').replace(/[^a-z0-9]/gi,'');
    const name=`${Date.now()}_${S.user.id.slice(0,8)}.${ext}`;
    const up=await db.storage.from('receipts').upload(name,file,{contentType:file.type});
    if(up.error)throw up.error;
    const url=db.storage.from('receipts').getPublicUrl(name).data.publicUrl;
    const ins=await db.from('orders').insert({user_email:S.user.email,product_name:S.cur.name,payment_method:S.method,amount_paid:amount,receipt_url:url,game_id:topUp?gameId:null,whatsapp:wa});
    if(ins.error)throw ins.error;
    toast('تم إرسال الطلب، سنراجعه قريباً','ok');closeAll();
    ['amount','gameId','wa','file'].forEach(i=>$(i).value='');
    showPage('myOrders');
  }catch(e){toast('تعذر إرسال الطلب: '+(e.message||'خطأ غير معروف'),'bad')}
  finally{S.busy=false;btn.disabled=false;btn.textContent='تأكيد الطلب'}
}

/* طلباتي */
async function loadOrders(){
  const box=$('orders');
  if(!S.user){box.innerHTML='<div class="empty">سجّل الدخول لعرض طلباتك.<br><br><button class="btn" style="max-width:200px" data-act="login">تسجيل الدخول</button></div>';return}
  box.innerHTML='<div class="skeleton" style="height:110px"></div>';
  const{data,error}=await db.from('orders').select('*').eq('user_email',S.user.email).order('created_at',{ascending:false});
  if(error){box.innerHTML='<div class="empty">تعذر تحميل الطلبات.</div>';return}
  if(!data.length){box.innerHTML='<div class="empty">لا توجد طلبات سابقة.</div>';return}
  const T={pending:'قيد الانتظار',approved:'مقبول',rejected:'مرفوض'};
  box.innerHTML=data.map(o=>{const st=T[o.status]?o.status:'pending';
    return `<div class="order"><span class="badge ${st}">${T[st]}</span>
    <h3 style="color:var(--gold)">${esc(o.product_name)}</h3>
    <p style="color:var(--muted);font-size:.88rem">${esc(o.payment_method)} | المبلغ: ${esc(o.amount_paid)}${o.created_at?' | '+new Date(o.created_at).toLocaleDateString('ar-DZ'):''}</p>
    ${o.game_id?`<p style="color:var(--gold-soft);font-weight:700;font-size:.9rem">الآيدي: ${esc(o.game_id)}</p>`:''}
    ${o.rejection_reason?`<p style="color:var(--red);margin-top:4px;font-size:.9rem">سبب الرفض: ${esc(o.rejection_reason)}</p>`:''}</div>`}).join('');
}

/* الحساب */
function setAuthMode(on){
  S.signUp=on;
  $('authTitle').textContent=on?'إنشاء حساب':'تسجيل الدخول';
  $('authBtn').textContent=on?'إنشاء':'دخول';
  $('authText').textContent=on?'لديك حساب؟':'ليس لديك حساب؟';
  $('authSwitch').textContent=on?'سجّل الدخول':'أنشئ حساباً';
  $('passNote').style.display=on?'block':'none';
  $('pass').autocomplete=on?'new-password':'current-password';
  $('authErr').style.display='none';
}
async function auth(){
  const email=$('email').value.trim(),password=$('pass').value,err=$('authErr'),btn=$('authBtn');
  const fail=m=>{err.textContent=m;err.style.display='block'};
  if(!email||!password)return fail('أدخل البريد وكلمة المرور');
  if(S.signUp&&password.length<6)return fail('كلمة المرور 6 أحرف على الأقل');
  btn.disabled=true;btn.textContent='...';err.style.display='none';
  try{
    if(S.signUp){
      const{data,error}=await db.auth.signUp({email,password});if(error)throw error;
      if(data.session){closeModal('authModal');toast('تم إنشاء الحساب','ok')}
      else{toast('تحقق من بريدك الإلكتروني لتأكيد الحساب ثم سجّل الدخول','ok');setAuthMode(false)}
    }else{
      const{error}=await db.auth.signInWithPassword({email,password});if(error)throw error;
      closeModal('authModal');toast('تم تسجيل الدخول','ok');
    }
  }catch(e){fail(e.message)}
  finally{btn.disabled=false;btn.textContent=S.signUp?'إنشاء':'دخول'}
}
async function onUser(user){
  S.user=user;
  $('userBtn').classList.toggle('on',!!user);
  await loadSettings();
  if($('page-myOrders').classList.contains('active'))loadOrders();
}

/* الأحداث */
document.addEventListener('click',e=>{
  const el=e.target.closest('[data-act],[data-page],[data-close],[data-copy]');
  if(e.target.classList.contains('modal'))return closeAll();
  if(!el)return;
  if(el.dataset.page)return showPage(el.dataset.page);
  if('close' in el.dataset)return closeAll();
  if(el.dataset.copy)return copyText(el.dataset.copy);
  const p=S.products.get(el.dataset.id);
  switch(el.dataset.act){
    case'details':if(p)showDetails(p);break;
    case'buy':if(p)buy(p);break;
    case'pay':selectPayment(el.dataset.m);break;
    case'retry':e.preventDefault();loadProducts();break;
    case'login':openModal('authModal');break;
  }
});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAll()});
$('userBtn').onclick=()=>{if(S.user){$('profileEmail').textContent=S.user.email;openModal('profileModal')}else openModal('authModal')};
$('authBtn').onclick=auth;
$('authSwitch').onclick=e=>{e.preventDefault();setAuthMode(!S.signUp)};
['email','pass'].forEach(i=>$(i).addEventListener('keydown',e=>{if(e.key==='Enter')auth()}));
$('submitOrder').onclick=submitOrder;
$('logout').onclick=async()=>{await db.auth.signOut();closeAll();showPage('home');toast('تم تسجيل الخروج')};
['games','accounts'].forEach(k=>$('q-'+k).addEventListener('input',renderProducts));

$('year').textContent=new Date().getFullYear();
db.auth.onAuthStateChange((_e,session)=>{setTimeout(()=>onUser(session?session.user:null),0)});
loadProducts();loadAds();
</script>
