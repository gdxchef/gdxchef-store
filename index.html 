<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
  const SUPABASE_URL = 'https://focoxfmdmcjofswmgkco.supabase.co';
  const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZvY294Zm1kbWNqb2Zzd21na2NvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM5MjMzMTYsImV4cCI6MjEwOTQ5OTMxNn0.H2At_v8QhrO89001o-y0nV0sXf3Ve6nSgUcqI3RtEq8';
  const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
  let currentUser = null; let isSignUpMode = false;
  let currentOrderProduct = ""; let currentOrderMethod = ""; let isTopUp = false;
  let currentSettings = null;

  function initApp() { checkSession(); loadProducts(); loadSettings(); }

  // جلب إعدادات الدفع من قاعدة البيانات
  async function loadSettings() {
    const { data, error } = await supabaseClient.from('settings').select('*').eq('id', 1).single();
    if (!error && data) currentSettings = data;
  }

  async function checkSession() {
    const { data: { session } } = await supabaseClient.auth.getSession();
    if(session) { currentUser = session.user; updateUI(); loadMyOrders(); }
  }
  function updateUI() { document.getElementById('userIconBtn').classList.toggle('logged-in', !!currentUser); }

  function handleUserIconClick() {
    if (currentUser) {
      document.getElementById('profileEmail').innerText = currentUser.email;
      document.getElementById('profileModal').style.display = 'grid';
    } else { document.getElementById('authModal').style.display = 'grid'; }
  }

  function closeModal(id) { document.getElementById(id).style.display = 'none'; }
  function toggleAuthMode() {
    isSignUpMode = !isSignUpMode;
    document.getElementById('authTitle').innerText = isSignUpMode ? 'إنشاء حساب' : 'تسجيل الدخول';
    document.getElementById('authSubmitBtn').innerText = isSignUpMode ? 'إنشاء' : 'دخول';
    document.getElementById('authSwitchText').innerText = isSignUpMode ? 'لديك حساب؟ ' : 'ليس لديك حساب؟ ';
    document.getElementById('authSwitchLink').innerText = isSignUpMode ? 'سجل الدخول' : 'أنشئ حساباً';
  }

  async function handleAuthSubmit() {
    const email = document.getElementById('authEmail').value;
    const password = document.getElementById('authPassword').value;
    const errorDiv = document.getElementById('authError');
    const submitBtn = document.getElementById('authSubmitBtn');
    if (!email || !password) { errorDiv.innerText = 'املأ الحقول'; errorDiv.style.display = 'block'; return; }
    submitBtn.innerText = '...'; submitBtn.disabled = true;
    try {
      if (isSignUpMode) {
        const { error } = await supabaseClient.auth.signUp({ email, password });
        if (error) throw error;
        alert('تم إنشاء الحساب! سجل الدخول الآن.'); toggleAuthMode();
      } else {
        const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
        if (error) throw error;
        currentUser = data.user; closeModal('authModal'); updateUI(); loadMyOrders();
      }
    } catch (error) { errorDiv.innerText = error.message; errorDiv.style.display = 'block'; } 
    finally { submitBtn.innerText = isSignUpMode ? 'إنشاء' : 'دخول'; submitBtn.disabled = false; }
  }

  async function handleLogout() { await supabaseClient.auth.signOut(); currentUser = null; closeModal('profileModal'); updateUI(); showPage('home'); }

  function showPage(pageId) {
    document.querySelectorAll('.page-section').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('nav a').forEach(el => el.classList.remove('active'));
    document.getElementById('page-' + pageId).classList.add('active');
    document.getElementById('nav-' + pageId).classList.add('active');
    if (pageId === 'myOrders') loadMyOrders();
  }

  async function loadProducts() {
    const { data: products, error } = await supabaseClient.from('products').select('*');
    if (error) return;
    const homeGrid = document.getElementById('home-products');
    const gamesGrid = document.getElementById('games-products');
    const accountsGrid = document.getElementById('accounts-products');
    homeGrid.innerHTML = ''; gamesGrid.innerHTML = ''; accountsGrid.innerHTML = '';
    products.forEach((product, index) => {
      const card = createProductCard(product);
      if (product.category === 'games' || product.category === 'apps') gamesGrid.appendChild(createProductCard(product));
      else if (product.category === 'accounts_ff' || product.category === 'accounts_efootball') accountsGrid.appendChild(createProductCard(product));
      if(index < 4) homeGrid.appendChild(createProductCard(product));
    });
  }

  function createProductCard(product) {
    const div = document.createElement('div');
    div.className = 'product-card';
    div.innerHTML = `<img src="${product.image_url || 'https://images.unsplash.com/photo-1552820728-8b83bb6b773f?w=500&q=80'}" class="product-img"><div class="product-info"><h3>${product.name}</h3><p>${product.description}</p><div class="price">${product.price} DA</div><button class="btn" onclick="handleBuy('${product.name}', '${product.category}')">شراء</button></div>`;
    return div;
  }

  function handleBuy(productName, type) {
    if (!currentUser) { alert('سجل الدخول أولاً!'); document.getElementById('authModal').style.display = 'grid'; return; }
    currentOrderProduct = productName;
    isTopUp = (type === 'games' || type === 'apps');
    document.getElementById('modal-product-name').innerText = productName;
    const optionsContainer = document.getElementById('payment-options');
    optionsContainer.innerHTML = type === 'accounts_ff' || type === 'accounts_efootball' 
      ? `<button class="pay-btn pay-ccp" onclick="selectPayment('CCP')">CCP / BaridiMob</button><button class="pay-btn pay-binance" onclick="selectPayment('Binance')">Binance</button>`
      : `<button class="pay-btn pay-flexy" onclick="selectPayment('Flexy')">Flexy</button><button class="pay-btn pay-ccp" onclick="selectPayment('CCP')">CCP / BaridiMob</button><button class="pay-btn pay-binance" onclick="selectPayment('Binance')">Binance</button>`;
    document.getElementById('paymentModal').style.display = 'grid';
  }

  // دالة لنسخ النص
  function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => {
      alert('تم النسخ بنجاح!');
    }).catch(err => {
      alert('فشل النسخ: ' + err);
    });
  }

  function selectPayment(method) {
    currentOrderMethod = method === 'CCP' ? 'CCP / BaridiMob' : method;
    closeModal('paymentModal');
    
    const box = document.getElementById('paymentDetails');
    box.innerHTML = '';

    if (currentSettings) {
      if (method === 'Flexy') {
        box.innerHTML = `<h4>الدفع عبر فليكسي (Flexy)</h4>
          <div class="info-row"><span>${currentSettings.flexy_number}</span><button class="copy-btn" onclick="copyToClipboard('${currentSettings.flexy_number}')">نسخ</button></div>
          <p style="text-align:center; font-size:0.85rem; color:var(--muted);">يرجى تحويل المبلغ إلى الرقم أعلاه.</p>`;
      } else if (method === 'CCP') {
        box.innerHTML = `<h4>الدفع عبر CCP / BaridiMob</h4>
          <div class="info-row"><span>${currentSettings.ccp_rib}</span><button class="copy-btn" onclick="copyToClipboard('${currentSettings.ccp_rib}')">نسخ RIB</button></div>
          <p>CCP: <strong>${currentSettings.ccp_rib}</strong> | المفتاح: <strong>${currentSettings.ccp_key}</strong></p>
          <p>الاسم: <strong>${currentSettings.ccp_name}</strong></p>
          <div class="warning-text">📌 يتوقف الدفع عبر هاته الطريقة على الساعة 9 ليلا ويعود الساعة 7 صباحا. أي دفع بعد الـ 9 مساءً مرفوض.</div>`;
      } else if (method === 'Binance') {
        box.innerHTML = `<h4>الدفع عبر Binance</h4>
          <p>البريد الإلكتروني: <strong>${currentSettings.binance_email}</strong></p>
          <div class="info-row"><span>ID: ${currentSettings.binance_id}</span><button class="copy-btn" onclick="copyToClipboard('${currentSettings.binance_id}')">نسخ ID</button></div>
          <p style="text-align:center; font-size:0.85rem; color:var(--muted);">يرجى تحويل المبلغ بالدولار عبر Binance.</p>`;
      }
    } else {
      box.innerHTML = '<p style="color:red;">خطأ في تحميل معلومات الدفع. يرجى تحديث الصفحة.</p>';
    }

    document.getElementById('gameIdGroup').style.display = isTopUp ? 'block' : 'none';
    document.getElementById('receiptModal').style.display = 'grid';
  }

  async function submitReceipt() {
    const amount = document.getElementById('receiptAmount').value;
    const gameId = document.getElementById('gameIdInput').value;
    const file = document.getElementById('receiptFile').files[0];
    const submitBtn = document.getElementById('submitReceiptBtn');
    
    if (!amount || !file) { alert('أدخل المبلغ وارفع الصورة'); return; }
    if (isTopUp && !gameId) { alert('أدخل الآيدي الخاص باللعبة'); return; }

    submitBtn.innerText = 'جاري...'; submitBtn.disabled = true;
    try {
      const fileName = `${Date.now()}_${currentUser.email.split('@')[0]}.${file.name.split('.').pop()}`;
      let { error: uploadError } = await supabaseClient.storage.from('receipts').upload(fileName, file);
      if (uploadError) throw uploadError;
      const { data: urlData } = supabaseClient.storage.from('receipts').getPublicUrl(fileName);
      
      const { error: dbError } = await supabaseClient.from('orders').insert({ 
        user_email: currentUser.email, 
        product_name: currentOrderProduct, 
        payment_method: currentOrderMethod, 
        amount_paid: amount, 
        receipt_url: urlData.publicUrl,
        game_id: isTopUp ? gameId : null
      });
      if (dbError) throw dbError;
      
      alert('تم إرسال الطلب! سنراجعه قريباً.'); 
      closeModal('receiptModal'); 
      document.getElementById('receiptAmount').value = ''; 
      document.getElementById('receiptFile').value = '';
      document.getElementById('gameIdInput').value = '';
      loadMyOrders();
    } catch (error) { alert('خطأ: ' + error.message); } 
    finally { submitBtn.innerText = 'تأكيد الطلب'; submitBtn.disabled = false; }
  }

  async function loadMyOrders() {
    if (!currentUser) return;
    const { data: orders, error } = await supabaseClient.from('orders').select('*').eq('user_email', currentUser.email).order('created_at', { ascending: false });
    if (error) return;

    const list = document.getElementById('my-orders-list');
    list.innerHTML = '';
    if (orders.length === 0) { list.innerHTML = '<p style="text-align:center; color:var(--muted);">لا توجد طلبات سابقة.</p>'; return; }

    orders.forEach(order => {
      let statusClass = order.status === 'pending' ? 'status-pending' : (order.status === 'approved' ? 'status-approved' : 'status-rejected');
      let statusText = order.status === 'pending' ? 'قيد الانتظار' : (order.status === 'approved' ? 'مقبول' : 'مرفوض');
      
      const card = document.createElement('div');
      card.className = 'order-history-card';
      card.innerHTML = `
        <div class="status-badge ${statusClass}">${statusText}</div>
        <h3 style="color: var(--gold); margin-bottom: 5px;">${order.product_name}</h3>
        <p style="color: var(--muted); font-size: 0.9rem;">طريقة الدفع: ${order.payment_method} | المبلغ: ${order.amount_paid}</p>
        ${order.game_id ? `<p style="color: var(--gold-soft); font-size: 0.9rem; font-weight: bold;">الآيدي: ${order.game_id}</p>` : ''}
        ${order.rejection_reason ? `<p style="color: #ff4d4d; margin-top: 5px; font-size: 0.9rem;">سبب الرفض: ${order.rejection_reason}</p>` : ''}
      `;
      list.appendChild(card);
    });
  }
</script>
</body>
</html>