<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>لوحة تحكم GDX CHEF</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  :root { --gold:#D4AF37; --bg:#0a0a0a; --card:#141414; --text:#F5F5F5; --muted:#A0A0A0; --yellow:#f39c12; --green:#25D366; --red:#ff4d4d; }
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Cairo', sans-serif; }
  body { background:var(--bg); color:var(--text); line-height: 1.6; }
  
  #login-screen { display: flex; justify-content: center; align-items: center; height: 100vh; background: var(--bg); }
  .login-box { background: var(--card); border: 1px solid var(--gold); padding: 30px; border-radius: 12px; width: 90%; max-width: 400px; text-align: center; }
  .login-box h2 { color: var(--gold); margin-bottom: 20px; }
  .login-box input { width: 100%; padding: 10px; margin-bottom: 10px; border-radius: 6px; border: 1px solid #333; background: #000; color: #fff; font-family: inherit; }
  .login-box button { width: 100%; padding: 10px; background: var(--gold); color: #000; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }

  #dashboard { display: none; padding: 20px; max-width: 1000px; margin: 0 auto; }
  header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 15px; }
  header h1 { color: var(--gold); font-size: 1.5rem; }
  .logout-btn { background: #ff4d4d; color: #fff; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-weight: bold; }

  .tabs { display: flex; gap: 10px; margin-bottom: 20px; overflow-x: auto; }
  .tab-btn { background: #222; color: var(--text); border: 1px solid #333; padding: 10px 15px; border-radius: 6px; cursor: pointer; font-weight: bold; white-space: nowrap; transition: 0.3s; }
  .tab-btn:hover { background: #333; }
  .tab-btn.active { background: var(--gold); color: #000; border-color: var(--gold); }
  .content-section { display: none; animation: fadeIn 0.3s; }
  .content-section.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  /* إعدادات الدفع */
  .settings-group { background: var(--card); border: 1px solid #333; border-radius: 10px; padding: 20px; margin-bottom: 20px; }
  .settings-group h3 { color: var(--gold); margin-bottom: 15px; border-bottom: 1px solid #333; padding-bottom: 5px; }
  .input-group { margin-bottom: 15px; }
  .input-group label { display: block; margin-bottom: 5px; color: var(--text); }
  .input-group input, .input-group select, .input-group textarea { width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #333; background: #000; color: #fff; font-family: inherit; transition: 0.3s; }
  .input-group input:focus { outline: none; border-color: var(--gold); }
  .save-btn { background: linear-gradient(45deg, #D4AF37, #F3E5AB); color: #000; border: none; padding: 12px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; transition: 0.3s; }
  .save-btn:hover { transform: scale(1.02); }

  /* المنتجات */
  .product-item { background: var(--card); border: 1px solid #333; border-radius: 10px; padding: 15px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; transition: 0.3s; }
  .product-item:hover { border-color: var(--gold); }
  .product-item h4 { color: var(--gold); }
  .product-item .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn-action { border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; transition: 0.3s; font-weight: bold; }
  .btn-delete { background: var(--red); color: #fff; }
  .btn-discount { background: var(--yellow); color: #000; }
  .btn-sold { background: #555; color: #fff; }
  .btn-hide { background: #333; color: #fff; border: 1px solid #555; }

  /* الطلبات */
  .order-card { background: var(--card); border: 1px solid #333; border-radius: 10px; padding: 15px; margin-bottom: 15px; }
  .order-header { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .order-header h3 { color: var(--gold); font-size: 1.1rem; }
  .status { padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: bold; }
  .status.pending { background: var(--yellow); color: #000; }
  .status.approved { background: var(--green); color: #fff; }
  .status.rejected { background: var(--red); color: #fff; }
  .order-details { font-size: 0.9rem; color: var(--muted); margin-bottom: 10px; }
  .order-details strong { color: var(--text); }
  .order-actions { display: flex; gap: 10px; margin-top: 10px; }
  .order-actions button { flex: 1; padding: 8px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.3s; }
  .btn-approve { background: var(--green); color: #fff; }
  .btn-reject { background: var(--red); color: #fff; }
  .receipt-img { width: 100%; max-height: 250px; object-fit: contain; border-radius: 6px; margin-top: 10px; border: 1px solid #333; cursor: pointer; }
  .reject-input { width: 100%; padding: 8px; margin-top: 10px; border-radius: 6px; border: 1px solid var(--red); background: #000; color: #fff; display: none; }
  .error-msg { color: var(--red); font-size: 0.9rem; margin-bottom: 10px; display: none; }

  /* الإعلانات */
  .ads-list { display: flex; flex-wrap: wrap; gap: 10px; }
  .ad-item { position: relative; width: 150px; }
  .ad-item img { width: 100%; border-radius: 6px; }
  .ad-item .btn-delete { position: absolute; top: 5px; right: 5px; padding: 2px 6px; }
</style>
</head>
<body>

<div id="login-screen">
  <div class="login-box">
    <h2>لوحة تحكم GDX CHEF</h2>
    <p style="color:var(--muted); margin-bottom: 15px; font-size: 0.9rem;">أدخل بريدك الإلكتروني المسجل كمدير</p>
    <div id="loginError" class="error-msg"></div>
    <input type="email" id="adminEmail" placeholder="البريد الإلكتروني">
    <input type="password" id="adminPassword" placeholder="كلمة المرور">
    <button onclick="adminLogin()">دخول</button>
  </div>
</div>

<div id="dashboard">
  <header>
    <h1>لوحة التحكم</h1>
    <button class="logout-btn" onclick="logout()">تسجيل الخروج</button>
  </header>

  <div class="tabs">
    <button class="tab-btn active" onclick="showTab('orders')">الطلبات</button>
    <button class="tab-btn" onclick="showTab('products')">إدارة المنتجات</button>
    <button class="tab-btn" onclick="showTab('ads')">الإعلانات</button>
    <button class="tab-btn" onclick="showTab('settings')">إعدادات الدفع</button>
  </div>

  <div id="tab-orders" class="content-section active">
    <h2 style="color:var(--gold); margin-bottom: 15px;">الطلبات الجديدة</h2>
    <div id="orders-list"></div>
  </div>

  <div id="tab-products" class="content-section">
    <h2 style="color:var(--gold); margin-bottom: 15px;">إدارة المنتجات</h2>
    
    <div class="settings-group">
      <h3>إضافة منتج جديد</h3>
      <div class="input-group"><label>اسم المنتج</label><input type="text" id="pName"></div>
      <div class="input-group"><label>الوصف</label><textarea id="pDesc" rows="3"></textarea></div>
      <div class="input-group"><label>السعر (DA)</label><input type="number" id="pPrice"></div>
      <div class="input-group"><label>السعر بعد التخفيض (اتركه 0 إذا لا يوجد)</label><input type="number" id="pDiscountPrice" value="0"></div>
      <div class="input-group"><label>التصنيف</label>
        <select id="pCategory">
          <option value="games">شحن ألعاب</option>
          <option value="apps">شحن تطبيقات</option>
          <option value="accounts_ff">حساب Free Fire</option>
          <option value="accounts_efootball">حساب eFOOTBALL</option>
        </select>
      </div>
      <div class="input-group"><label>رابط الصورة الرئيسية (URL)</label><input type="text" id="pImage" placeholder="https://..."></div>
      <div class="input-group"><label>روابط الصور الإضافية (URL)</label><textarea id="pExtraImages" rows="3" placeholder="رابط صورة 1&#10;رابط صورة 2&#10;رابط صورة 3"></textarea></div>
      <button class="save-btn" onclick="addProduct()">إضافة المنتج</button>
    </div>

    <h3 style="color:var(--gold); margin-bottom: 10px;">المنتجات الحالية</h3>
    <div id="products-list"></div>
  </div>

  <div id="tab-ads" class="content-section">
    <h2 style="color:var(--gold); margin-bottom: 15px;">إدارة الإعلانات</h2>
    <div class="settings-group">
      <h3>إضافة إعلان جديد</h3>
      <div class="input-group"><label>رابط صورة الإعلان</label><input type="text" id="adImage" placeholder="https://..."></div>
      <button class="save-btn" onclick="addAd()">إضافة الإعلان</button>
    </div>
    <div class="ads-list" id="ads-list"></div>
  </div>

  <div id="tab-settings" class="content-section">
    <h2 style="color:var(--gold); margin-bottom: 15px;">إعدادات الدفع</h2>
    <div class="settings-group">
      <h3>Flexy</h3>
      <div class="input-group"><label>رقم الفليكسي</label><input type="text" id="setFlexy"></div>
    </div>
    <div class="settings-group">
      <h3>CCP / BaridiMob</h3>
      <div class="input-group"><label>رقم CCP (الحساب)</label><input type="text" id="setCcpNum"></div>
      <div class="input-group"><label>المفتاح (Clé)</label><input type="text" id="setKey"></div>
      <div class="input-group"><label>RIB</label><input type="text" id="setRib"></div>
      <div class="input-group"><label>الاسم الكامل</label><input type="text" id="setName"></div>
    </div>
    <div class="settings-group">
      <h3>Binance</h3>
      <div class="input-group"><label>ID الحساب</label><input type="text" id="setBinanceId"></div>
      <div class="input-group"><label>البريد الإلكتروني</label><input type="text" id="setBinanceEmail"></div>
    </div>
    <button class="save-btn" onclick="saveSettings()">حفظ التغييرات</button>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
  const SUPABASE_URL = 'https://focoxfmdmcjofswmgkco.supabase.co';
  const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZvY294Zm1kbWNqb2Zzd21na2NvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM5MjMzMTYsImV4cCI6MjEwOTQ5OTMxNn0.H2At_v8QhrO89001o-y0nV0sXf3Ve6nSgUcqI3RtEq8';
  const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  window.onload = async function() {
    const { data: { session } } = await supabaseClient.auth.getSession();
    if (session && session.user.email === 'chefgdx@gmail.com') {
      document.getElementById('login-screen').style.display = 'none';
      document.getElementById('dashboard').style.display = 'block';
      loadOrders(); loadProductsForAdmin(); loadAdsForAdmin(); loadSettingsForForm();
    }
  };

  async function adminLogin() {
    const email = document.getElementById('adminEmail').value;
    const password = document.getElementById('adminPassword').value;
    const errorDiv = document.getElementById('loginError');
    errorDiv.style.display = 'none';
    const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
    if (error) { errorDiv.innerText = 'خطأ: ' + error.message; errorDiv.style.display = 'block'; return; }
    if (data.user.email === 'chefgdx@gmail.com') { 
      document.getElementById('login-screen').style.display = 'none';
      document.getElementById('dashboard').style.display = 'block';
      loadOrders(); loadProductsForAdmin(); loadAdsForAdmin(); loadSettingsForForm();
    } else {
      alert('عذراً، هذا الحساب ليس لديه صلاحيات المدير!');
      await supabaseClient.auth.signOut();
    }
  }

  async function logout() {
    await supabaseClient.auth.signOut();
    document.getElementById('dashboard').style.display = 'none';
    document.getElementById('login-screen').style.display = 'flex';
  }

  function showTab(tabId) {
    document.querySelectorAll('.content-section').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + tabId).classList.add('active');
    event.target.classList.add('active');
  }

  async function loadOrders() {
    const { data: orders } = await supabaseClient.from('orders').select('*').order('created_at', { ascending: false });
    const list = document.getElementById('orders-list');
    list.innerHTML = '';
    if (!orders || orders.length === 0) { list.innerHTML = '<p style="text-align:center; color:var(--muted);">لا توجد طلبات.</p>'; return; }
    orders.forEach(order => {
      let statusClass = order.status === 'pending' ? 'pending' : (order.status === 'approved' ? 'approved' : 'rejected');
      let statusText = order.status === 'pending' ? 'قيد الانتظار' : (order.status === 'approved' ? 'مقبول' : 'مرفوض');
      const card = document.createElement('div');
      card.className = 'order-card';
      card.innerHTML = `
        <div class="order-header"><h3>${order.product_name}</h3><span class="status ${statusClass}">${statusText}</span></div>
        <div class="order-details">
          <p><strong>الزبون:</strong> ${order.user_email}</p>
          <p><strong>الواتساب:</strong> ${order.whatsapp || 'غير متوفر'}</p>
          <p><strong>طريقة الدفع:</strong> ${order.payment_method}</p>
          <p><strong>المبلغ:</strong> ${order.amount_paid}</p>
          ${order.game_id ? `<p style="color:var(--gold); font-weight:bold;">الآيدي: ${order.game_id}</p>` : ''}
        </div>
        ${order.receipt_url ? `<img src="${order.receipt_url}" class="receipt-img" onclick="window.open(this.src)">` : ''}
        ${order.status === 'pending' ? `<input type="text" id="reject-reason-${order.id}" class="reject-input" placeholder="سبب الرفض..."><div class="order-actions"><button class="btn-approve" onclick="updateOrderStatus(${order.id}, 'approved')">قبول</button><button class="btn-reject" onclick="promptReject(${order.id})">رفض</button></div>` : ''}
      `;
      list.appendChild(card);
    });
  }

  function promptReject(orderId) {
    const reasonInput = document.getElementById(`reject-reason-${orderId}`);
    if (reasonInput.style.display === 'none' || reasonInput.style.display === '') { reasonInput.style.display = 'block'; reasonInput.focus(); } 
    else { const reason = reasonInput.value; if (!reason) { alert('اكتب سبب الرفض'); return; } updateOrderStatus(orderId, 'rejected', reason); }
  }

  async function updateOrderStatus(orderId, newStatus, reason = '') {
    if (!confirm('هل أنت متأكد؟')) return;
    const updateData = { status: newStatus };
    if (newStatus === 'rejected' && reason) updateData.rejection_reason = reason;
    await supabaseClient.from('orders').update(updateData).eq('id', orderId);
    loadOrders();
  }

  async function loadProductsForAdmin() {
    const { data: products } = await supabaseClient.from('products').select('*').order('created_at', { ascending: false });
    const list = document.getElementById('products-list');
    list.innerHTML = '';
    if (!products) return;
    products.forEach(p => {
      const div = document.createElement('div');
      div.className = 'product-item';
      div.innerHTML = `
        <div style="flex: 1;">
          <h4>${p.name} ${p.is_hidden ? '(مخفي)' : ''} ${p.is_sold ? '(تم البيع)' : ''}</h4>
          <span style="color:var(--muted); font-size:0.8rem;">${p.price} DA ${p.discount_price > 0 ? `-> ${p.discount_price} DA` : ''} | ${p.category}</span>
        </div>
        <div class="actions">
          <button class="btn-action btn-discount" onclick="setDiscount(${p.id}, ${p.price})">تخفيض</button>
          <button class="btn-action btn-sold" onclick="markAsSold(${p.id}, ${p.is_sold})">${p.is_sold ? 'إلغاء البيع' : 'تم البيع'}</button>
          <button class="btn-action btn-hide" onclick="toggleHide(${p.id}, ${p.is_hidden})">${p.is_hidden ? 'إظهار' : 'إخفاء'}</button>
          <button class="btn-action btn-delete" onclick="deleteProduct(${p.id})">حذف</button>
        </div>
      `;
      list.appendChild(div);
    });
  }

  async function addProduct() {
    const name = document.getElementById('pName').value;
    const desc = document.getElementById('pDesc').value;
    const price = document.getElementById('pPrice').value;
    const discountPrice = document.getElementById('pDiscountPrice').value;
    const category = document.getElementById('pCategory').value;
    const image = document.getElementById('pImage').value;
    const extraImagesText = document.getElementById('pExtraImages').value;
    const extraImages = extraImagesText.split('\n').filter(url => url.trim() !== '');

    if (!name || !price) { alert('أدخل الاسم والسعر'); return; }
    const { error } = await supabaseClient.from('products').insert({ name, description: desc, price, discount_price: discountPrice, category, image_url: image, images: extraImages });
    if (error) { alert('خطأ: ' + error.message); return; }
    alert('تم إضافة المنتج بنجاح!');
    document.getElementById('pName').value = ''; document.getElementById('pDesc').value = ''; document.getElementById('pPrice').value = ''; document.getElementById('pDiscountPrice').value = '0'; document.getElementById('pImage').value = ''; document.getElementById('pExtraImages').value = '';
    loadProductsForAdmin();
  }

  async function setDiscount(id, originalPrice) {
    const newPrice = prompt(`أدخل السعر الجديد بعد التخفيض (السعر الأصلي: ${originalPrice}):`, originalPrice);
    if (newPrice === null) return;
    await supabaseClient.from('products').update({ discount_price: newPrice }).eq('id', id);
    loadProductsForAdmin();
  }

  async function markAsSold(id, currentStatus) {
    await supabaseClient.from('products').update({ is_sold: !currentStatus }).eq('id', id);
    loadProductsForAdmin();
  }

  async function toggleHide(id, currentStatus) {
    await supabaseClient.from('products').update({ is_hidden: !currentStatus }).eq('id', id);
    loadProductsForAdmin();
  }

  async function deleteProduct(id) {
    if (!confirm('هل أنت متأكد من حذف المنتج؟')) return;
    await supabaseClient.from('products').delete().eq('id', id);
    loadProductsForAdmin();
  }

  async function loadAdsForAdmin() {
    const { data: ads } = await supabaseClient.from('ads').select('*');
    const list = document.getElementById('ads-list');
    list.innerHTML = '';
    if (!ads) return;
    ads.forEach(ad => {
      list.innerHTML += `<div class="ad-item"><img src="${ad.image_url}"><button class="btn-action btn-delete" onclick="deleteAd(${ad.id})">حذف</button></div>`;
    });
  }

  async function addAd() {
    const image = document.getElementById('adImage').value;
    if (!image) { alert('أدخل رابط الصورة'); return; }
    await supabaseClient.from('ads').insert({ image_url: image });
    document.getElementById('adImage').value = '';
    loadAdsForAdmin();
  }

  async function deleteAd(id) {
    if (!confirm('حذف الإعلان؟')) return;
    await supabaseClient.from('ads').delete().eq('id', id);
    loadAdsForAdmin();
  }

  async function loadSettingsForForm() {
    const { data, error } = await supabaseClient.from('settings').select('*').eq('id', 1).single();
    if (error) return;
    document.getElementById('setFlexy').value = data.flexy_number || '';
    document.getElementById('setCcpNum').value = data.ccp_number || '';
    document.getElementById('setKey').value = data.ccp_key || '';
    document.getElementById('setRib').value = data.ccp_rib || '';
    document.getElementById('setName').value = data.ccp_name || '';
    document.getElementById('setBinanceId').value = data.binance_id || '';
    document.getElementById('setBinanceEmail').value = data.binance_email || '';
  }

  async function saveSettings() {
    const flexy = document.getElementById('setFlexy').value;
    const ccpNum = document.getElementById('setCcpNum').value;
    const key = document.getElementById('setKey').value;
    const rib = document.getElementById('setRib').value;
    const name = document.getElementById('setName').value;
    const binanceId = document.getElementById('setBinanceId').value;
    const binanceEmail = document.getElementById('setBinanceEmail').value;
    const { error } = await supabaseClient.from('settings').update({
      flexy_number: flexy, ccp_number: ccpNum, ccp_key: key, ccp_rib: rib, ccp_name: name, binance_id: binanceId, binance_email: binanceEmail
    }).eq('id', 1);
    if (error) { alert('خطأ: ' + error.message); return; }
    alert('تم حفظ الإعدادات بنجاح!');
  }
</script>
</body>
</html>